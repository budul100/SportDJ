<Window
    x:Class="SportDJ.App.Views.MainView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cv="using:SportDJ.Modules.ControllerModule.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dv="using:SportDJ.Modules.DisplayModule.Views"
    xmlns:gv="using:SportDJ.Modules.GridModule.Views"
    xmlns:i="using:Avalonia.Xaml.Interactivity"
    xmlns:ia="using:Avalonia.Xaml.Interactions.Core"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:SportDJ.App.ViewModels"
    xmlns:vml="using:SportDJ.Shareds.ViewModelLocator"
    Title="{Binding Title}"
    Width="{Binding Width, Mode=TwoWay}"
    Height="{Binding Height, Mode=TwoWay}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    vml:ViewModelLocator.AutoWireViewModel="True"
    x:DataType="vm:MainViewModel"
    Icon="/Assets/SportDJ.png"
    WindowState="{Binding WindowState, Mode=TwoWay}"
    mc:Ignorable="d">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Commons/Assets/Ressources.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <i:Interaction.Behaviors>
        <ia:EventTriggerBehavior EventName="Closing">
            <ia:InvokeCommandAction Command="{Binding OnClosingCommand}" PassEventArgsToCommand="True" />
        </ia:EventTriggerBehavior>
    </i:Interaction.Behaviors>

    <Grid>

        <Grid.RowDefinitions>
            <!-- Display Region -->
            <RowDefinition Height="1*" MinHeight="60" />
            <!-- Panel Top -->
            <RowDefinition Height="{Binding PanelTopHeight, Converter={StaticResource DoubleToGridPixelConverter}, Mode=TwoWay}" MinHeight="0" />
            <!-- Splitter Top -->
            <RowDefinition Height="Auto" />
            <!-- Main Region -->
            <RowDefinition Height="15*" />
            <!-- Splitter Bottom -->
            <RowDefinition Height="Auto" />
            <!-- Panel Bottom -->
            <RowDefinition Height="{Binding PanelBottomHeight, Converter={StaticResource DoubleToGridPixelConverter}, Mode=TwoWay}" MinHeight="0" />
            <!-- Controller Region -->
            <RowDefinition Height="2*" MinHeight="120" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <!-- Panel Left -->
            <ColumnDefinition Width="{Binding PanelLeftWidth, Converter={StaticResource DoubleToGridPixelConverter}, Mode=TwoWay}" MinWidth="0" />
            <!-- Splitter Left -->
            <ColumnDefinition Width="Auto" />
            <!-- Main Content -->
            <ColumnDefinition Width="10*" />
            <!-- Splitter Right -->
            <ColumnDefinition Width="Auto" />
            <!-- Panel Right -->
            <ColumnDefinition Width="{Binding PanelRightWidth, Converter={StaticResource DoubleToGridPixelConverter}, Mode=TwoWay}" MinWidth="0" />
        </Grid.ColumnDefinitions>

        <!-- Display -->
        <dv:DisplayView
            Grid.Row="0"
            Grid.Column="0"
            Grid.ColumnSpan="7" />

        <!-- Panel Top -->
        <ContentControl
            Grid.Row="1"
            Grid.Column="0"
            Grid.ColumnSpan="7"
            Content="{Binding PanelTop}" />

        <!-- Panel Top Splitter -->
        <GridSplitter
            Grid.Row="2"
            Grid.Column="0"
            Grid.ColumnSpan="7"
            Height="3"
            HorizontalAlignment="Stretch"
            ResizeDirection="Rows"
            Focusable="False"
            IsVisible="{Binding PanelTop, Converter={x:Static ObjectConverters.IsNotNull}}">
            <i:Interaction.Behaviors>
                <ia:EventTriggerBehavior EventName="DoubleTapped">
                    <ia:InvokeCommandAction Command="{Binding ClosePanelTopCommand}" />
                </ia:EventTriggerBehavior>
            </i:Interaction.Behaviors>
        </GridSplitter>

        <!--
        <Panel Grid.Row="3" Grid.Column="0">

        <ContentControl Content="{Binding CurrentSingleView}"
        IsVisible="{Binding ShowSingleView}" />

        <TabControl ItemsSource="{Binding LeftPanelTabs}"
        IsVisible="{Binding ShowTabs}">

        <TabControl.ItemTemplate>
        <DataTemplate>
        <TextBlock Text="{Binding Header}" />
        </DataTemplate>
        </TabControl.ItemTemplate>

        <TabControl.ContentTemplate>
        <DataTemplate>
        <ContentControl Content="{Binding View}" />
        </DataTemplate>
        </TabControl.ContentTemplate>
        </TabControl>

        </Panel>
        -->

        <!-- Panel Left -->
        <ContentControl
            Grid.Row="3"
            Grid.Column="0"
            Content="{Binding PanelLeft}" />

        <!-- Panel Left Splitter -->
        <GridSplitter
            Grid.Row="3"
            Grid.Column="1"
            Width="3"
            VerticalAlignment="Stretch"
            ResizeDirection="Columns"
            Focusable="False"
            IsVisible="{Binding PanelLeft, Converter={x:Static ObjectConverters.IsNotNull}}">
            <i:Interaction.Behaviors>
                <ia:EventTriggerBehavior EventName="DoubleTapped">
                    <ia:InvokeCommandAction Command="{Binding ClosePanelLeftCommand}" />
                </ia:EventTriggerBehavior>
            </i:Interaction.Behaviors>
        </GridSplitter>

        <!-- Player Canvas -->
        <gv:CanvasView
            Grid.Row="3"
            Grid.Column="2" />

        <!-- Panel Right Splitter -->
        <GridSplitter
            Grid.Row="3"
            Grid.Column="3"
            Width="3"
            VerticalAlignment="Stretch"
            ResizeDirection="Columns"
            Focusable="False"
            IsVisible="{Binding PanelRight, Converter={x:Static ObjectConverters.IsNotNull}}">
            <i:Interaction.Behaviors>
                <ia:EventTriggerBehavior EventName="DoubleTapped">
                    <ia:InvokeCommandAction Command="{Binding ClosePanelRightCommand}" />
                </ia:EventTriggerBehavior>
            </i:Interaction.Behaviors>
        </GridSplitter>

        <!-- Panel Right -->
        <ContentControl
            Grid.Row="3"
            Grid.Column="4"
            Content="{Binding PanelRight}" />

        <!-- Panel Bottom Splitter -->
        <GridSplitter
            Grid.Row="4"
            Grid.Column="0"
            Grid.ColumnSpan="7"
            Height="3"
            HorizontalAlignment="Stretch"
            ResizeDirection="Rows"
            Focusable="False"
            IsVisible="{Binding PanelBottom, Converter={x:Static ObjectConverters.IsNotNull}}">
            <i:Interaction.Behaviors>
                <ia:EventTriggerBehavior EventName="DoubleTapped">
                    <ia:InvokeCommandAction Command="{Binding ClosePanelBottomCommand}" />
                </ia:EventTriggerBehavior>
            </i:Interaction.Behaviors>
        </GridSplitter>

        <!-- Panel Bottom -->
        <ContentControl
            Grid.Row="5"
            Grid.Column="0"
            Grid.ColumnSpan="7"
            Content="{Binding PanelBottom}" />

        <!-- Controller -->
        <cv:ControllerView
            Grid.Row="6"
            Grid.Column="0"
            Grid.ColumnSpan="7" />

    </Grid>
</Window>
