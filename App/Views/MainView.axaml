<Window
    x:Class="SportDJ.App.Views.MainView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:a="clr-namespace:Avalonia.Xaml.Interactions.Core;assembly=Avalonia.Xaml.Interactions"
    xmlns:co="using:SportDJ.Commons.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:en="using:SportDJ.Commons.Enums"
    xmlns:i="clr-namespace:Avalonia.Xaml.Interactivity;assembly=Avalonia.Xaml.Interactivity"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:vm="using:SportDJ.App.ViewModels"
    Title="{Binding Title}"
    Width="{Binding Width, Mode=TwoWay}"
    Height="{Binding Height, Mode=TwoWay}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    prism:ViewModelLocator.AutoWireViewModel="True"
    x:DataType="vm:MainViewModel"
    Icon="/Assets/avalonia-logo.ico"
    WindowState="{Binding WindowState, Mode=TwoWay}"
    mc:Ignorable="d">

    <Window.Resources>
        <co:EnumToStringConverter x:Key="EnumToStringConverter" />
    </Window.Resources>

    <i:Interaction.Behaviors>
        <a:EventTriggerBehavior EventName="Closing">
            <a:InvokeCommandAction Command="{Binding OnClosingCommand}" PassEventArgsToCommand="True" />
        </a:EventTriggerBehavior>
    </i:Interaction.Behaviors>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*" MinHeight="60" />
            <RowDefinition Height="15*" />
            <RowDefinition Height="2*" MinHeight="120" />
        </Grid.RowDefinitions>

        <ContentControl Grid.Row="0">
            <prism:RegionManager.RegionName>
                <Binding Converter="{StaticResource EnumToStringConverter}" Source="{x:Static en:RegionType.DisplayRegion}" />
            </prism:RegionManager.RegionName>
        </ContentControl>

        <ContentControl Grid.Row="1">
            <prism:RegionManager.RegionName>
                <Binding Converter="{StaticResource EnumToStringConverter}" Source="{x:Static en:RegionType.PlayerRegion}" />
            </prism:RegionManager.RegionName>
        </ContentControl>

        <ContentControl Grid.Row="2">
            <prism:RegionManager.RegionName>
                <Binding Converter="{StaticResource EnumToStringConverter}" Source="{x:Static en:RegionType.ControllerRegion}" />
            </prism:RegionManager.RegionName>
        </ContentControl>
    </Grid>
</Window>