<Window
    x:Class="SportDJ.App.Views.MainView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:en="using:SportDJ.Commons.Enums"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:vm="using:SportDJ.App.ViewModels"
    Title="{Binding Title}"
    Width="{Binding Width, Mode=TwoWay}"
    Height="{Binding Height, Mode=TwoWay}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    prism:ViewModelLocator.AutoWireViewModel="True"
    x:DataType="vm:MainViewModel"
    Icon="/Assets/SportDJ.png"
    WindowState="{Binding WindowState, Mode=TwoWay}"
    mc:Ignorable="d">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Commons/Assets/Ressources.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Interaction.Behaviors>
        <EventTriggerBehavior EventName="Closing">
            <InvokeCommandAction Command="{Binding OnClosingCommand}" PassEventArgsToCommand="True" />
        </EventTriggerBehavior>
    </Interaction.Behaviors>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="1*" MinHeight="60" />
            <RowDefinition Height="15*" />
            <RowDefinition Height="2*" MinHeight="120" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding PanelWidth, Converter={StaticResource DoubleToGridPixelConverter}, Mode=TwoWay}" />
            <ColumnDefinition Width="3" />
            <ColumnDefinition Width="10*" />
            <ColumnDefinition Width="3" />
            <ColumnDefinition Width="{Binding SettingsWidth, Converter={StaticResource DoubleToGridPixelConverter}, Mode=TwoWay}" />
        </Grid.ColumnDefinitions>

        <ContentControl
            Grid.Row="0"
            Grid.Column="0"
            Grid.ColumnSpan="5">
            <prism:RegionManager.RegionName>
                <Binding Converter="{StaticResource EnumToStringConverter}" Source="{x:Static en:RegionType.DisplayRegion}" />
            </prism:RegionManager.RegionName>
        </ContentControl>

        <ContentControl 
            Grid.Row="1" 
            Grid.Column="0" 
            Content="{Binding Panel}" />
        
        <GridSplitter
            Grid.Row="1"
            Grid.Column="1"
            HorizontalAlignment="Stretch"
            Focusable="False" />

        <ContentControl Grid.Row="1" Grid.Column="2">
            <prism:RegionManager.RegionName>
                <Binding Converter="{StaticResource EnumToStringConverter}" Source="{x:Static en:RegionType.PlayerRegion}" />
            </prism:RegionManager.RegionName>
        </ContentControl>

        <GridSplitter
            Grid.Row="1"
            Grid.Column="3"
            HorizontalAlignment="Stretch"
            Focusable="False" />

        <ContentControl Grid.Row="1" Grid.Column="4">
            <prism:RegionManager.RegionName>
                <Binding Converter="{StaticResource EnumToStringConverter}" Source="{x:Static en:RegionType.SettingsRegion}" />
            </prism:RegionManager.RegionName>
        </ContentControl>

        <ContentControl
            Grid.Row="2"
            Grid.Column="0"
            Grid.ColumnSpan="5">
            <prism:RegionManager.RegionName>
                <Binding Converter="{StaticResource EnumToStringConverter}" Source="{x:Static en:RegionType.ControllerRegion}" />
            </prism:RegionManager.RegionName>
        </ContentControl>
    </Grid>
</Window>