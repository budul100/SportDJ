<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFrameworks>net8.0-windows</TargetFrameworks>
		<RootNamespace>SportDJ.App</RootNamespace>
		<VersionMajor>1</VersionMajor>
		<VersionMinor>7</VersionMinor>
		<VersionBuild>0</VersionBuild>
		<AssemblyName>SportDJ</AssemblyName>
		<AssemblyVersion>$(VersionMajor).$(VersionMinor).$(VersionBuild)</AssemblyVersion>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<ApplicationIcon>Assets\SportDJ.ico</ApplicationIcon>
		<PublishReadyToRun>true</PublishReadyToRun>
		<PublishReadyToRunShowWarnings>true</PublishReadyToRunShowWarnings>
		<AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
		<IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
		<BuiltInComInteropSupport>true</BuiltInComInteropSupport>
		<EnableWindowsTargeting>true</EnableWindowsTargeting>
		<IsRidAgnostic>false</IsRidAgnostic>
	</PropertyGroup>

	<ItemGroup>
		<AvaloniaResource Include="Assets\**" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia" Version="11.3.10" />
		<PackageReference Include="Avalonia.Desktop" Version="11.3.10" />
		<PackageReference Include="Avalonia.LinuxFramebuffer" Version="11.3.10" />
		<PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.10" />
		<PackageReference Include="Prism.DryIoc.Avalonia" Version="9.0.537.11130" />
		<PackageReference Include="Xaml.Behaviors.Avalonia" Version="11.3.9" />
		<PackageReference Include="Xaml.Behaviors.Interactions" Version="11.3.9" />
		<PackageReference Include="Xaml.Behaviors.Interactivity" Version="11.3.9" />
		<!--Condition below is needed to remove Avalonia.Diagnostics package from build output in Release configuration.-->
		<PackageReference Condition="'$(Configuration)' == 'Debug'" Include="Avalonia.Diagnostics" Version="11.3.10" />
	</ItemGroup>
	
	<ItemGroup>
		<ProjectReference Include="..\Commons\Commons.csproj" />
		<ProjectReference Include="..\Modules\GridModule\GridModule.csproj" />
		<ProjectReference Include="..\Modules\ControllerModule\ControllerModule.csproj" />
		<ProjectReference Include="..\Modules\DisplayModule\DisplayModule.csproj" />
		<ProjectReference Include="..\Modules\MenuModule\MenuModule.csproj" />
		<ProjectReference Include="..\Modules\SearchModule\SearchModule.csproj" />
		<ProjectReference Include="..\Modules\SettingsModule\SettingsModule.csproj" />
		<ProjectReference Include="..\Modules\StackModule\StackModule.csproj" />
		<ProjectReference Include="..\Services\DialogService\DialogService.csproj" />
		<ProjectReference Include="..\Services\DispatcherService\DispatcherService.csproj" />
		<ProjectReference Include="..\Services\GridService\GridService.csproj" />
		<ProjectReference Include="..\Services\MixerService\MixerService.csproj" />
		<ProjectReference Include="..\Services\OutputService\OutputService.csproj" />
		<ProjectReference Include="..\Services\PanelService\PanelService.csproj" />
		<ProjectReference Include="..\Services\PlayerService\PlayerService.csproj" />
		<ProjectReference Include="..\Services\StackService\StackService.csproj" />
		<ProjectReference Include="..\Services\StorageService\StorageService.csproj" />
		<ProjectReference Include="..\Services\TrackService\TrackService.csproj" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Services\DeviceService.Windows\DeviceService.Windows.csproj" />
		<ProjectReference Include="..\Services\MonitorService.Windows\MonitorService.Windows.csproj" />
		<ProjectReference Include="..\Services\SignalService.Windows\SignalService.Windows.csproj" />
		<ProjectReference Include="..\Shareds\SampleProviders\SampleProviders.Windows\SampleProviders.Windows.csproj" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Services\MonitorService.Mixxx\MonitorService.Mixxx.csproj" />
	</ItemGroup>

</Project>