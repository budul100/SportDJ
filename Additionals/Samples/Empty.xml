<Set xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<Grid>
		<Cells>
			<Cell xsi:type="Player" Column="0" Row="0" Name="Player 1">
				<IsForeground>false</IsForeground>
				<IsLoop>false</IsLoop>
				<Paths />
				<SavePosition>false</SavePosition>
			</Cell>
		</Cells>
	</Grid>
	<Options>
		<DisableInterruptingDialogs>false</DisableInterruptingDialogs>
		<FadeOnLowerMilliseconds>200</FadeOnLowerMilliseconds>
		<FadeOnMixInMilliseconds>100</FadeOnMixInMilliseconds>
		<FadeOnMixOutMilliseconds>500</FadeOnMixOutMilliseconds>
		<FadeOnPauseMilliseconds>500</FadeOnPauseMilliseconds>
		<KeyCodeOutputPause>VcEnter</KeyCodeOutputPause>
		<KeyCodeScreenChange>VcF11</KeyCodeScreenChange>
		<KeyCodeVolumeTalk>VcSpace</KeyCodeVolumeTalk>
		<SelectNextOnPauseSeconds>10</SelectNextOnPauseSeconds>
		<SelectNextOnPlaySeconds>10</SelectNextOnPlaySeconds>
		<TrimRearPercentage>10</TrimRearPercentage>
		<TrimVolumePercentage>0</TrimVolumePercentage>
	</Options>
	<Outputs>
		<Output Type="Live">
			<DeviceName>Lautsprecher (Realtek(R) Audio)</DeviceName>
			<SampleRate>44100</SampleRate>
			<Volume>1</Volume>
			<VolumePercentageApps>20</VolumePercentageApps>
			<VolumePercentageBackground>20</VolumePercentageBackground>
		</Output>
		<Output Type="PFL">
			<SampleRate>0</SampleRate>
			<Volume>1</Volume>
			<VolumePercentageApps>20</VolumePercentageApps>
			<VolumePercentageBackground>20</VolumePercentageBackground>
		</Output>
	</Outputs>
</Set>