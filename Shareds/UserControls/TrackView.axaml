<UserControl
    x:Class="SportDJ.Shareds.UserControls.TrackView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:SportDJ.Shareds.UserControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:SportDJ.Commons.Models.Contents"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    d:DesignHeight="40"
    d:DesignWidth="300"
    mc:Ignorable="d"
    x:Name="Root"
    x:DataType="local:WaveRenderer">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Commons/Assets/Ressources.axaml" />
            </ResourceDictionary.MergedDictionaries>

            <Thickness x:Key="InnerMargin">1</Thickness>
        </ResourceDictionary>
    </UserControl.Resources>

    <Design.DataContext>
        <models:Track 
            Title="Example Song" 
            Info="More Info" 
            Counter="5">
            <models:Track.Duration>
                <sys:TimeSpan>0:04:15</sys:TimeSpan>
            </models:Track.Duration>
        </models:Track>
    </Design.DataContext>

    <Border
        Margin="{StaticResource ContentMargin}"
        BorderThickness="{StaticResource PlayerBorderThickness}"
        CornerRadius="{StaticResource PlayerCornerRadius}">

        <Grid Grid.Row="0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Viewbox
                Grid.Column="0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Stretch="Uniform"
                StretchDirection="DownOnly">
                <TextBlock
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    FontSize="{StaticResource FontSizeState}"
                    Text="{Binding #Root.Counter}" />
            </Viewbox>

            <Viewbox
                Grid.Column="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Stretch="Uniform"
                StretchDirection="DownOnly">
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="{StaticResource FontSizeContentMain}"
                    Text="{Binding #Root.Track.Info}" />
            </Viewbox>

            <Viewbox
                Grid.Column="2"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Stretch="Uniform"
                StretchDirection="DownOnly">
                <TextBlock
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    FontSize="{StaticResource FontSizeState}"
                    Text="{Binding #Root.Duration}" />
            </Viewbox>
        </Grid>
    </Border>
</UserControl>