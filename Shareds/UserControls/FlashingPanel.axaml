<UserControl
    x:Class="SportDJ.Shareds.UserControls.FlashingPanel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:SportDJ.Shareds.UserControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="200"
    d:DesignWidth="400"
    mc:Ignorable="d"
    x:Name="Root"
    x:DataType="local:FlashingPanel">

    <!-- The opacity animation is created in code behind, because bindings are not supported inside animations -->
    <Panel
        Name="FlashPanel"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        Background="{Binding #Root.Color}"
        IsVisible="{Binding #Root.IsActive}" />
</UserControl>
