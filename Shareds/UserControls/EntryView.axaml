<UserControl
    x:Class="SportDJ.Shareds.UserControls.EntryView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:SportDJ.Shareds.UserControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:SportDJ.Commons.Models.Contents"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    d:DesignHeight="40"
    d:DesignWidth="300"
    mc:Ignorable="d"
    x:Name="Root">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Commons/Assets/Ressources.axaml" />
            </ResourceDictionary.MergedDictionaries>

            <Thickness x:Key="InnerMargin">1</Thickness>
        </ResourceDictionary>
    </UserControl.Resources>

    <Design.DataContext>
        <models:Entry>
            <models:Entry.Track>
                <models:Track 
                    Title="Example Song" 
                    Info="More Info" 
                    Counter="5">
                    <models:Track.Duration>
                        <sys:TimeSpan>0:04:15</sys:TimeSpan>
                    </models:Track.Duration>
                </models:Track>
            </models:Entry.Track>
        </models:Entry>
    </Design.DataContext>

    <Border
        Name="SelectionBorder"
        Margin="0"
        BorderThickness="{StaticResource PlayerBorderThickness}"
        Classes.IsSelected="{Binding #Root.IsSelected}"
        CornerRadius="{StaticResource PlayerCornerRadius}">

        <Border.Styles>
            <Style Selector="Border.IsSelected">
                <Setter Property="BorderBrush" Value="{StaticResource ColorIsSelected}" />
            </Style>
            <Style Selector="Border">
                <Setter Property="BorderBrush" Value="Transparent" />
            </Style>
        </Border.Styles>
        
        <Grid Margin="{StaticResource ContentMargin}">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="10*" />
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                FontStyle="{Binding #Root.IsPlayed, Converter={StaticResource BoolToFontStyleConverter}, ConverterParameter={StaticResource TrackFontStylePlayed}}"
                FontWeight="{Binding #Root.IsSelected, Converter={StaticResource BoolToFontWeightConverter}, ConverterParameter={StaticResource TrackFontWeightSelected}}"
                FontSize="{StaticResource TrackFontSize}"
                Text="{Binding #Root.Info}" />

            <TextBlock
                Grid.Column="1"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                FontStyle="{Binding #Root.IsPlayed, Converter={StaticResource BoolToFontStyleConverter}, ConverterParameter={StaticResource TrackFontStylePlayed}}"
                FontWeight="{Binding #Root.IsSelected, Converter={StaticResource BoolToFontWeightConverter}, ConverterParameter={StaticResource TrackFontWeightSelected}}"
                FontSize="{StaticResource TrackFontSize}"
                Text="{Binding #Root.Duration}" />

            <TextBlock
                Grid.Column="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontStyle="{Binding #Root.IsPlayed, Converter={StaticResource BoolToFontStyleConverter}, ConverterParameter={StaticResource TrackFontStylePlayed}}"
                FontWeight="{Binding #Root.IsSelected, Converter={StaticResource BoolToFontWeightConverter}, ConverterParameter={StaticResource TrackFontWeightSelected}}"
                FontSize="{StaticResource TrackFontSize}"
                Text="{Binding #Root.Counter}" />
        
        </Grid>
    </Border>
</UserControl>