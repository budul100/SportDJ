<UserControl
    x:Class="SportDJ.Shareds.UserControls.WaveRenderer"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:co="using:SportDJ.Commons.Converters"
    xmlns:local="using:SportDJ.Shareds.UserControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:media="clr-namespace:Avalonia.Media;assembly=Avalonia.Visuals"
    d:DesignHeight="200"
    d:DesignWidth="400"
    mc:Ignorable="d"
    x:Name="Root"
    x:DataType="local:WaveRenderer">
    
    <Grid>
        
        <Image
            VerticalAlignment="Stretch"
            HorizontalAlignment="Stretch"
            StretchDirection="Both"
            IsVisible="{Binding !#Root.IsPlaying}"
            Source="{Binding #Root.Bitmap}"
            Stretch="Fill" />
    
        <Image
            VerticalAlignment="Stretch"
            HorizontalAlignment="Stretch"
            StretchDirection="Both"
            IsVisible="{Binding #Root.IsPlaying}"
            Source="{Binding #Root.Bitmap}"
            Opacity="{Binding #Root.OpacityPlayed}" 
            Stretch="Fill" 
            Clip="{Binding #Root.PlayedClip}" />
    
        <Image
            VerticalAlignment="Stretch"
            HorizontalAlignment="Stretch"
            StretchDirection="Both"
            IsVisible="{Binding #Root.IsPlaying}"
            Source="{Binding #Root.Bitmap}"
            Stretch="Fill" 
            Clip="{Binding #Root.RemainingClip}" />

    </Grid>

</UserControl>