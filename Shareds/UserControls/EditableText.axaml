<UserControl
    x:Class="SportDJ.Shareds.UserControls.EditableText"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:SportDJ.Shareds.UserControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="200"
    d:DesignWidth="400"
    mc:Ignorable="d"
    x:Name="Root"
    x:DataType="local:EditableText">

    <Grid>

        <TextBlock
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            FontSize="{Binding #Root.FontSize}"
            IsVisible="{Binding !#Root.IsActive}"
            Text="{Binding #Root.Text}" />

        <TextBox
            Name="TextBox"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            AcceptsReturn="False"
            AcceptsTab="False"
            Focusable="True"
            FontSize="{Binding #Root.FontSize}"
            GotFocus="OnGotFocus"
            IsUndoEnabled="True"
            IsVisible="{Binding #Root.IsActive}"
            KeyDown="OnKeyDown"
            LostFocus="OnLostFocus"
            MaxLength="{Binding #Root.MaxLength}"
            MaxLines="1"
            Text="{Binding #Root.Text}"
            TextAlignment="Justify"
            TextWrapping="NoWrap" />

    </Grid>
</UserControl>