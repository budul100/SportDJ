<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:co="using:SportDJ.Commons.Converters">

    <!--
        Central design tokens of the application.
        Rules: gaps are multiples of 2, corner radii follow the three step scale below,
        font sizes follow the type scale below. Control styles live in Styles.axaml.
    -->

    <!-- ===== Behaviour (unchanged) ===== -->

    <x:Double x:Key="SplashViewSize">500</x:Double>
    <x:TimeSpan x:Key="TogglePressDuration">0:0:0.500</x:TimeSpan>

    <!-- ===== Spacing ===== -->

    <!-- Outer gutter of a panel or a cell -->
    <Thickness x:Key="ContentMargin">4</Thickness>
    <!-- Inner gutter between elements inside a cell (2 + 2 = 4 between two neighbours) -->
    <Thickness x:Key="InnerMargin">2</Thickness>

    <x:Double x:Key="SpacingSmall">4</x:Double>
    <x:Double x:Key="SpacingMedium">8</x:Double>

    <!-- ===== Corner radii ===== -->

    <CornerRadius x:Key="RadiusSmall">4</CornerRadius>
    <CornerRadius x:Key="RadiusMedium">6</CornerRadius>
    <CornerRadius x:Key="RadiusLarge">10</CornerRadius>

    <!-- Same keys as the Fluent theme uses, so every standard control follows the scale -->
    <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>

    <!-- ===== Sizes ===== -->

    <x:Double x:Key="ControlHeight">32</x:Double>

    <x:Double x:Key="MediumIconSize">20</x:Double>
    <x:Double x:Key="LargeIconSize">30</x:Double>

    <!-- Legacy, kept because shared controls might still use it -->
    <x:Double x:Key="TextBoxHeight">20</x:Double>

    <!-- ===== Colors (unchanged) ===== -->

    <Color x:Key="ColorBackground">#333333</Color>
    <Color x:Key="ColorBackgroundToggle">DodgerBlue</Color>
    <Color x:Key="ColorIsSelected">RoyalBlue</Color>
    <Color x:Key="ColorIsPlaying">Purple</Color>
    <Color x:Key="ColorIsEnding">DarkRed</Color>

    <!-- ===== Type scale: 11 / 14 / 16 / 20 ===== -->

    <x:Double x:Key="FontSizeSettings">11</x:Double>
    <x:Double x:Key="FontSizeState">14</x:Double>
    <x:Double x:Key="FontSizeContentSub">16</x:Double>
    <x:Double x:Key="FontSizeContentMain">20</x:Double>

    <FontWeight x:Key="FontWeightLabel">Medium</FontWeight>
    <FontWeight x:Key="FontWeightTitle">SemiBold</FontWeight>

    <!-- ===== Key badge ===== -->

    <Color x:Key="KeyBackgroundColor">DimGray</Color>
    <Color x:Key="KeyBorderColor">LightGray</Color>
    <Thickness x:Key="KeyBorderThickness">1</Thickness>
    <CornerRadius x:Key="KeyCornerRadius">4</CornerRadius>
    <Thickness x:Key="KeyPadding">6,1,6,1</Thickness>
    <Thickness x:Key="KeyMargin">4</Thickness>

    <!-- Keys of the numeric keypad keep the badge, but get another background and the keypad symbol -->
    <Color x:Key="KeyNumpadBackgroundColor">#3E5C76</Color>

    <!-- ===== Player card ===== -->

    <!-- Outer radius 10 = inner radius 6 + gap 4 (border 2 + inner margin 2), so the corners stay concentric -->
    <Thickness x:Key="PlayerBorderThickness">2</Thickness>
    <!-- Distance of the elements inside of a player (rows and buttons), half of it at each element -->
    <Thickness x:Key="PlayerInnerMargin">1</Thickness>
    <CornerRadius x:Key="PlayerCornerRadius">10</CornerRadius>
    <x:Double x:Key="PlayerIconSize">30</x:Double>

    <Thickness x:Key="GroupTabMargin">16,6,16,6</Thickness>

    <!-- ===== Display bar ===== -->

    <Thickness x:Key="DisplayBorderThickness">2</Thickness>
    <CornerRadius x:Key="DisplayCornerRadius">6</CornerRadius>

    <x:Double x:Key="DisplayOpacityPlaying">0.3</x:Double>
    <x:Double x:Key="DisplayOpacityEndingMin">0.2</x:Double>
    <x:Double x:Key="DisplayOpacityEndingMax">0.5</x:Double>
    <x:Double x:Key="DisplayFlashingDurationMilliSecs">750</x:Double>
    <x:Double x:Key="DisplayIconSize">30</x:Double>

    <!-- ===== Tracks ===== -->

    <x:Double x:Key="TrackOpacityPlayed">0.5</x:Double>
    <x:Double x:Key="TrackFontSize">14</x:Double>
    <FontStyle x:Key="TrackFontStylePlayed">Italic</FontStyle>
    <FontWeight x:Key="TrackFontWeightSelected">Bold</FontWeight>

    <!-- ===== Converters ===== -->

    <co:BoolToGridSizeAutoConverter x:Key="BoolToGridSizeAutoConverter" />
    <co:BoolToGridSizeStarConverter x:Key="BoolToGridSizeStarConverter" />

    <co:EnumToStringConverter x:Key="EnumToStringConverter" />
    <co:DoubleToGridPixelConverter x:Key="DoubleToGridPixelConverter" />

    <co:BoolToFontStyleConverter x:Key="BoolToFontStyleConverter" />
    <co:BoolToFontWeightConverter x:Key="BoolToFontWeightConverter" />
    <co:BoolToColorConverter x:Key="BoolToColorConverter" />

    <co:CapabilityTypeConverter x:Key="CapabilityTypeConverter" />
</ResourceDictionary>
