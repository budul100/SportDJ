<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:co="using:SportDJ.Commons.Converters">

    <Thickness x:Key="ContentMargin">4</Thickness>

    <Color x:Key="ColorBackground">#333333</Color>
    <Color x:Key="ColorIsChecked">RoyalBlue</Color>
    <Color x:Key="ColorIsForeground">DarkSlateGray</Color>
    <Color x:Key="ColorIsPlaying">Purple</Color>
    <Color x:Key="ColorIsEnding">DarkRed</Color>

    <x:Double x:Key="FontSizeContent">30</x:Double>
    <x:Double x:Key="FontSizeDisplay">20</x:Double>
    <x:Double x:Key="FontSizeState">20</x:Double>
    <x:Double x:Key="FontSizeVolume">10</x:Double>

    <Color x:Key="KeyBackgroundColor">DimGray</Color>
    <Color x:Key="KeyBorderColor">LightGray</Color>
    <Thickness x:Key="KeyBorderThickness">1</Thickness>
    <CornerRadius x:Key="KeyCornerRadius">0</CornerRadius>
    <Thickness x:Key="KeyPadding">15,0,15,0</Thickness>
    <Thickness x:Key="KeyMargin">5</Thickness>

    <Thickness x:Key="PlayerBorderThickness">2</Thickness>
    <CornerRadius x:Key="PlayerCornerRadius">2</CornerRadius>
    <x:Double x:Key="PlayerIconSize">30</x:Double>

    <FontStyle x:Key="MenuFontStylePlayed">Italic</FontStyle>
    <FontWeight x:Key="MenuFontWeightSelected">Bold</FontWeight>
    <x:Double x:Key="MenuIconSize">30</x:Double>

    <Thickness x:Key="GroupTabMargin">30,10,30,10</Thickness>

    <Thickness x:Key="DisplayBorderThickness">2</Thickness>
    <CornerRadius x:Key="DisplayCornerRadius">4</CornerRadius>

    <x:Double x:Key="DisplayOpacityPlaying">0.3</x:Double>
    <x:Double x:Key="DisplayOpacityEndingMin">0.2</x:Double>
    <x:Double x:Key="DisplayOpacityEndingMax">0.5</x:Double>
    <x:Double x:Key="DisplayFlashingDurationMilliSecs">750</x:Double>
    <x:Double x:Key="DisplayIconSize">30</x:Double>

    <x:Double x:Key="TrackOpacityPlayed">0.5</x:Double>

    <x:Double x:Key="SettingsIconSize">30</x:Double>
    <x:Double x:Key="ControllerIconSize">40</x:Double>

    <co:BoolToGridSizeAutoConverter x:Key="BoolToGridSizeAutoConverter" />
    <co:BoolToGridSizeStarConverter x:Key="BoolToGridSizeStarConverter" />

    <co:EnumToStringConverter x:Key="EnumToStringConverter" />
    <co:DoubleToGridPixelConverter x:Key="DoubleToGridPixelConverter" />

    <co:BoolToFontStyleConverter x:Key="BoolToFontStyleConverter" />
    <co:BoolToFontWeightConverter x:Key="BoolToFontWeightConverter" />
    <co:BoolToColorConverter x:Key="BoolToColorConverter" />
</ResourceDictionary>