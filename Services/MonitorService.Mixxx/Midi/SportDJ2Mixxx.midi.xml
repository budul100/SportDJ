<?xml version='1.0' encoding='utf-8'?>
<MixxxControllerPreset mixxxVersion="" schemaVersion="1">
	<info>
		<name>SportDJ2Mixxx</name>
		<author>budul</author>
		<description>Mapping for SportDJ to control Mixxx via loopMidi</description>
	</info>
	<controller id="SportDJ2Mixxx">
		<scriptfiles/>
		<controls>
			<control>
				<group>[Master]</group>
				<key>gain_down_small</key>
				<status>0xB0</status>
				<midino>0x07</midino>
				<options>
					<soft-takeover/>
				</options>
			</control>
            <control>
                <group>[Master]</group>
                <key>gain_set_default</key>
                <status>0x90</status>
                <midino>0x40</midino>
                <options>
                    <normal/>
                </options>
            </control>
			<control>
				<group>[Channel1]</group>
				<key>stop</key>
				<status>0x90</status>
				<midino>0x41</midino>
				<options>
					<switch/>
				</options>
			</control>
			<control>
				<group>[Channel2]</group>
				<key>stop</key>
				<status>0x90</status>
				<midino>0x42</midino>
				<options>
					<switch/>
				</options>
			</control>
			<control>
				<group>[Channel3]</group>
				<key>stop</key>
				<status>0x90</status>
				<midino>0x43</midino>
				<options>
					<switch/>
				</options>
			</control>
			<control>
				<group>[Channel4]</group>
				<key>stop</key>
				<status>0x90</status>
				<midino>0x44</midino>
				<options>
					<switch/>
				</options>
			</control>
		</controls>
		<outputs/>
	</controller>
</MixxxControllerPreset>