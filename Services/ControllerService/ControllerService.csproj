<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Library</OutputType>
		<TargetFramework>net8.0</TargetFramework>
		<RootNamespace>SportDJ.Services.$(MSBuildProjectName.Replace(" ", ""))</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Commons\Commons.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="budul.RegexExtensions" Version="1.5.1" />
		<PackageReference Include="NAudio.Midi" Version="2.2.1" />
	</ItemGroup>

	<ItemGroup>
		<None Remove="Midi\ControllerProfiles.xml" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="Midi\ControllerProfiles.xml">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

</Project>