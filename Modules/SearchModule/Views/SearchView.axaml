<UserControl
    x:Class="SportDJ.Modules.SearchModule.Views.SearchView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ct="using:SportDJ.Shareds.UserControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dt="using:SportDJ.Modules.SearchModule.DesignTime"
    xmlns:mat="using:Material.Icons.Avalonia"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:SportDJ.Commons.Models.Contents"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:vm="using:SportDJ.Modules.SearchModule.ViewModels"
    d:DesignHeight="500"
    d:DesignWidth="300"
    prism:ViewModelLocator.AutoWireViewModel="True"
    x:DataType="vm:SearchViewModel"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Commons/Assets/Ressources.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.Styles>
        <mat:MaterialIconStyles />
    </UserControl.Styles>

    <Design.DataContext>
        <dt:SearchViewModel />
    </Design.DataContext>

    <DockPanel IsEnabled="{Binding IsActive}" LastChildFill="True">

        <DockPanel
            Margin="{StaticResource ContentMargin}"
            DockPanel.Dock="Top"
            LastChildFill="True">

            <Button
                Margin="{StaticResource InnerMargin}"
                VerticalAlignment="Center"
                Classes="Tool"
                Command="{Binding ClearCommand}"
                DockPanel.Dock="Right"
                Focusable="False">
                <mat:MaterialIcon
                    Width="{StaticResource MediumIconSize}"
                    Height="{StaticResource MediumIconSize}"
                    Kind="CloseBold" />
            </Button>

            <TextBox
                Margin="{StaticResource InnerMargin}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                AcceptsReturn="False"
                DockPanel.Dock="Left"
                Focusable="False"
                Text="{Binding Search, Mode=TwoWay}"
                PlaceholderText="Search track" />
        </DockPanel>

        <ListBox
            Margin="{StaticResource ContentMargin}"
            ItemsSource="{Binding Entries}">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="models:Entry">
                    <ct:EntryView Entry="{Binding}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

    </DockPanel>
</UserControl>
