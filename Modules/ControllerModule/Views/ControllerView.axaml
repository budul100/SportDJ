<UserControl
    x:Class="SportDJ.Modules.ControllerModule.Views.ControllerView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:a="clr-namespace:Avalonia.Xaml.Interactions.Core;assembly=Avalonia.Xaml.Interactions"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dt="using:SportDJ.Modules.ControllerModule.DesignTime"
    xmlns:en="using:SportDJ.Commons.Enums"
    xmlns:i="clr-namespace:Avalonia.Xaml.Interactivity;assembly=Avalonia.Xaml.Interactivity"
    xmlns:mat="using:Material.Icons.Avalonia"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    d:DesignHeight="50"
    d:DesignWidth="300"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Commons/Assets/Ressources.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>

        <Thickness x:Key="InnerMargin">1</Thickness>
    </UserControl.Resources>

    <UserControl.Styles>
        <mat:MaterialIconStyles />
    </UserControl.Styles>

    <Design.DataContext>
        <dt:ControllerViewModel />
    </Design.DataContext>

    <i:Interaction.Behaviors>

        <a:EventTriggerBehavior EventName="PointerPressed" SourceObject="VolumeButton">
            <a:InvokeCommandAction Command="{Binding VolumeLowerCommand}" />
        </a:EventTriggerBehavior>

        <a:EventTriggerBehavior EventName="PointerReleased" SourceObject="VolumeButton">
            <a:InvokeCommandAction Command="{Binding VolumeRaiseCommand}" />
        </a:EventTriggerBehavior>
    </i:Interaction.Behaviors>

    <Grid Margin="{StaticResource ContentMargin}">

        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <ToggleButton
            Grid.Row="0"
            Grid.Column="0"
            Margin="{StaticResource InnerMargin}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Focusable="False"
            IsChecked="{Binding VolumeMonitoringActive}">
            <mat:MaterialIcon
                Width="{StaticResource LargeIconSize}"
                Height="{StaticResource LargeIconSize}"
                Kind="VolumeMute" />
        </ToggleButton>

        <Button
            Name="VolumeButton"
            Grid.Row="0"
            Grid.Column="1"
            Margin="{StaticResource InnerMargin}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Focusable="False"
            IsEnabled="{Binding IsActive}">

            <prism:RegionManager.RegionName>
                <Binding Converter="{StaticResource EnumToStringConverter}" Source="{x:Static en:RegionType.MenuRegion}" />
            </prism:RegionManager.RegionName>

            <Grid
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="{StaticResource ColorBackground}">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="{Binding HasKeyTalkVolume, Converter={StaticResource BoolToGridSizeAutoConverter}}" />
                </Grid.ColumnDefinitions>

                <mat:MaterialIcon
                    Grid.Column="0"
                    Width="{StaticResource LargeIconSize}"
                    Height="{StaticResource LargeIconSize}"
                    Kind="Microphone" />

                <Border
                    Grid.Column="1"
                    Padding="{StaticResource KeyPadding}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Background="{StaticResource KeyBackgroundColor}"
                    BorderBrush="{StaticResource KeyBorderColor}"
                    BorderThickness="{StaticResource KeyBorderThickness}"
                    CornerRadius="{StaticResource KeyCornerRadius}"
                    IsVisible="{Binding HasKeyTalkVolume}">

                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="{StaticResource FontSizeContentMain}"
                        Text="{Binding KeyTalkVolume}" />
                </Border>
            </Grid>
        </Button>

        <Button
            Grid.Row="0"
            Grid.Column="2"
            Margin="{StaticResource InnerMargin}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Command="{Binding PauseCommand}"
            Focusable="False"
            IsEnabled="{Binding IsActive}">

            <Grid
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="{StaticResource ColorBackground}">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="{Binding HasKeyPauseOutput, Converter={StaticResource BoolToGridSizeAutoConverter}}" />
                </Grid.ColumnDefinitions>

                <mat:MaterialIcon
                    Grid.Column="0"
                    Width="{StaticResource LargeIconSize}"
                    Height="{StaticResource LargeIconSize}"
                    Kind="PauseCircle" />

                <Border
                    Grid.Column="1"
                    Padding="15,0,15,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Background="{StaticResource KeyBackgroundColor}"
                    BorderBrush="{StaticResource KeyBorderColor}"
                    BorderThickness="{StaticResource KeyBorderThickness}"
                    CornerRadius="{StaticResource KeyCornerRadius}"
                    IsVisible="{Binding HasKeyPauseOutput}">

                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="{StaticResource FontSizeContentMain}"
                        Text="{Binding KeyPauseOutput}" />
                </Border>
            </Grid>
        </Button>
    </Grid>
</UserControl>