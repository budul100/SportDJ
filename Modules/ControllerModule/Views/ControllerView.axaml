<UserControl
    x:Class="SportDJ.Modules.ControllerModule.Views.ControllerView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ct="using:SportDJ.Shareds.UserControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dt="using:SportDJ.Modules.ControllerModule.DesignTime"
    xmlns:en="using:SportDJ.Commons.Enums"
    xmlns:i="using:Avalonia.Xaml.Interactivity"
    xmlns:ia="using:Avalonia.Xaml.Interactions.Core"
    xmlns:local="using:SportDJ.Modules.ControllerModule.Behaviors"
    xmlns:mat="using:Material.Icons.Avalonia"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:SportDJ.Modules.ControllerModule.ViewModels"
    xmlns:vml="using:SportDJ.Shareds.ViewModelLocator"
    d:DesignHeight="50"
    d:DesignWidth="300"
    vml:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d"
    x:DataType="vm:ControllerViewModel"
    x:CompileBindings="True">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Commons/Assets/Ressources.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.Styles>
        <mat:MaterialIconStyles />
    </UserControl.Styles>

    <Design.DataContext>
        <dt:ControllerViewModel />
    </Design.DataContext>

    <Grid Margin="{StaticResource ContentMargin}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Loop -->
        <Button
            Grid.Row="0"
            Grid.Column="0"
            Margin="{StaticResource InnerMargin}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Classes="Surface"
            Focusable="False"
            Command="{Binding LoopCommand}"
            IsEnabled="{Binding IsLoopEnabled}">

            <Border Classes="StateSurface Filled" Classes.IsActive="{Binding IsLoop}">
                <mat:MaterialIcon
                    Width="{StaticResource LargeIconSize}"
                    Height="{StaticResource LargeIconSize}"
                    Kind="Repeat" />
            </Border>
        </Button>

        <!-- Monitoring -->
        <Button
            Grid.Row="0"
            Grid.Column="1"
            Margin="{StaticResource InnerMargin}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Classes="Surface"
            Focusable="False"
            Command="{Binding MonitoringCommand}"
            IsEnabled="{Binding IsMonitoringEnabled}">

            <Border Classes="StateSurface Filled" Classes.IsActive="{Binding IsMonitoring}">
                <mat:MaterialIcon
                    Width="{StaticResource LargeIconSize}"
                    Height="{StaticResource LargeIconSize}"
                    Kind="VolumeMute" />
            </Border>
        </Button>

        <!-- Talk (lowers the output while pressed) -->
        <Button
            Name="VolumeButton"
            Grid.Row="0"
            Grid.Column="2"
            Margin="{StaticResource InnerMargin}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Classes="Surface"
            Focusable="False"
            Background="Transparent"
            IsEnabled="{Binding IsActive}">

            <i:Interaction.Behaviors>
                <local:PointerCaptureBehavior
                    local:PointerCaptureBehavior.IsPointerPressed="{Binding IsVolumePressed, Mode=TwoWay}"
                    HoldDuration="{StaticResource TogglePressDuration}"
                    HoldStartCommand="{Binding VolumeLowerCommand}"
                    HoldEndCommand="{Binding VolumeRaiseCommand}" />
            </i:Interaction.Behaviors>

            <Border Classes="StateSurface Filled" Classes.IsActive="{Binding IsVolumeLowered}">
                <Grid
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{Binding HasKeyTalkVolume, Converter={StaticResource BoolToGridSizeAutoConverter}}" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <mat:MaterialIcon
                        Grid.Column="1"
                        Width="{StaticResource LargeIconSize}"
                        Height="{StaticResource LargeIconSize}"
                        Kind="Microphone" />

                    <ct:KeyDisplay
                        Grid.Column="0"
                        Margin="{StaticResource KeyMargin}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        FontSize="{StaticResource FontSizeContentMain}"
                        IsVisible="{Binding HasKeyTalkVolume}"
                        KeyCode="{Binding KeyCodeTalkVolume}" />
                </Grid>
            </Border>
        </Button>

        <!-- Pause -->
        <Button
            Grid.Row="0"
            Grid.Column="3"
            Margin="{StaticResource InnerMargin}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Classes="Surface"
            Command="{Binding PauseCommand}"
            Focusable="False"
            IsEnabled="{Binding IsActive}">

            <Border Classes="StateSurface Filled">
                <Grid
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{Binding HasKeyPauseOutput, Converter={StaticResource BoolToGridSizeAutoConverter}}" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <mat:MaterialIcon
                        Grid.Column="1"
                        Width="{StaticResource LargeIconSize}"
                        Height="{StaticResource LargeIconSize}"
                        Kind="PauseCircle" />

                    <ct:KeyDisplay
                        Grid.Column="0"
                        Margin="{StaticResource KeyMargin}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        FontSize="{StaticResource FontSizeContentMain}"
                        IsVisible="{Binding HasKeyPauseOutput}"
                        KeyCode="{Binding KeyCodePauseOutput}" />
                </Grid>
            </Border>
        </Button>

        <!-- Settings of the control keys: opens and closes the left pane, checked while it shows them -->
        <ToggleButton
            Grid.Row="0"
            Grid.Column="4"
            MinWidth="60"
            Margin="{StaticResource InnerMargin}"
            HorizontalAlignment="Right"
            HorizontalContentAlignment="Center"
            VerticalAlignment="Stretch"
            VerticalContentAlignment="Center"
            Classes="SettingsToggle"
            Command="{Binding ShowSettingsCommand}"
            IsChecked="{Binding IsSettingsVisible, Mode=OneWay}">
            <mat:MaterialIcon
                Width="{StaticResource MediumIconSize}"
                Height="{StaticResource MediumIconSize}"
                Kind="Build" />
        </ToggleButton>

    </Grid>
</UserControl>