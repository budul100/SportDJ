<UserControl
    x:Class="SportDJ.Modules.ContentModule.Views.GridView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:co="using:SportDJ.Commons.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dt="using:SportDJ.Modules.ContentModule.DesignTime"
    xmlns:hp="using:SportDJ.Modules.ContentModule.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:v="using:SportDJ.Modules.ContentModule.Views"
    xmlns:vm="using:SportDJ.Modules.ContentModule.ViewModels"
    d:DesignHeight="300"
    d:DesignWidth="300"
    prism:ViewModelLocator.AutoWireViewModel="False"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Commons/Assets/Ressources.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Design.DataContext>
        <dt:GridViewModel />
    </Design.DataContext>

    <ItemsControl ItemsSource="{Binding Elements}">

        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <Grid
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    hp:GridHelpers.ColumnCount="{Binding Columns}"
                    hp:GridHelpers.RowCount="{Binding Rows}" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>

        <ItemsControl.Styles>
            <Style Selector="ItemsControl > ContentPresenter">
                <Setter Property="Grid.Row" Value="{Binding Row}" />
                <Setter Property="Grid.Column" Value="{Binding Column}" />
                <Setter Property="Grid.RowSpan" Value="{Binding RowSpan}" />
                <Setter Property="Grid.ColumnSpan" Value="{Binding ColumnSpan}" />
            </Style>
        </ItemsControl.Styles>

        <ItemsControl.DataTemplates>
            <DataTemplate x:DataType="vm:GroupViewModel">
                <v:GroupView />
            </DataTemplate>
            <DataTemplate x:DataType="vm:PlayerViewModel">
                <v:PlayerView />
            </DataTemplate>
            <DataTemplate x:DataType="dt:GroupViewModel">
                <v:GroupView />
            </DataTemplate>
            <DataTemplate x:DataType="vm:PlayerViewModel">
                <v:PlayerView />
            </DataTemplate>
        </ItemsControl.DataTemplates>
    </ItemsControl>
</UserControl>