<UserControl
    x:Class="SportDJ.Modules.ContentModule.Views.ControllerView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dt="using:SportDJ.Modules.ContentModule.DesignTime"
    xmlns:mat="using:Material.Icons.Avalonia"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    Grid.Row="2"
    d:DesignHeight="150"
    d:DesignWidth="150"
    prism:ViewModelLocator.AutoWireViewModel="False"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Commons/Assets/Ressources.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>

        <Thickness x:Key="InnerMargin">1</Thickness>

        <x:Double x:Key="ContentFontSize">20</x:Double>
        <x:Double x:Key="StateFontSize">15</x:Double>

        <x:Double x:Key="IconWidth">30</x:Double>
        <x:Double x:Key="IconHeight">30</x:Double>
    </UserControl.Resources>

    <UserControl.Styles>
        <mat:MaterialIconStyles />
    </UserControl.Styles>

    <Design.DataContext>
        <dt:ControllerViewModel />
    </Design.DataContext>

    <Grid Margin="{DynamicResource ContentMargin}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*" />
            <RowDefinition Height="4*" />
        </Grid.RowDefinitions>

        <Button
            Grid.Row="0"
            Grid.Column="0"
            Margin="{DynamicResource InnerMargin}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Command="{Binding TrackBackwardCommand}">
            <mat:MaterialIcon
                Width="{StaticResource IconWidth}"
                Height="{StaticResource IconHeight}"
                Kind="SkipBackward" />
        </Button>

        <Button
            Grid.Row="0"
            Grid.Column="1"
            Margin="{DynamicResource InnerMargin}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch" />

        <Button
            Grid.Row="0"
            Grid.Column="2"
            Margin="{DynamicResource InnerMargin}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Command="{Binding TrackForwardCommand}">
            <mat:MaterialIcon
                Width="{StaticResource IconWidth}"
                Height="{StaticResource IconHeight}"
                Kind="SkipForward" />
        </Button>

        <Button
            Grid.Row="1"
            Grid.Column="0"
            Grid.ColumnSpan="3"
            Margin="{DynamicResource InnerMargin}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Command="{Binding ExecuteCommand}">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="{DynamicResource ContentFontSize}"
                    Text="{Binding Artist}" />
                <TextBlock
                    Grid.Row="1"
                    Grid.Column="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="{DynamicResource ContentFontSize}"
                    FontWeight="Bold"
                    Text="{Binding Title}" />
                <Grid Grid.Row="2" Grid.Column="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        FontSize="{StaticResource StateFontSize}"
                        Text="{Binding Remaining}" />
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        FontSize="{StaticResource StateFontSize}"
                        Text="{Binding Counter}" />
                </Grid>
            </Grid>
        </Button>
    </Grid>
</UserControl>