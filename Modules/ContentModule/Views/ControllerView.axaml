<UserControl
    x:Class="SportDJ.Modules.ContentModule.Views.ControllerView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dt="using:SportDJ.Modules.ContentModule.DesignTime"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    Grid.Row="2"
    d:DesignHeight="150"
    d:DesignWidth="150"
    prism:ViewModelLocator.AutoWireViewModel="False"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Commons/Assets/Ressources.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
        <x:Double x:Key="ContentFontSize">20</x:Double>
        <x:Double x:Key="StateFontSize">15</x:Double>
    </UserControl.Resources>

    <Design.DataContext>
        <dt:ControllerViewModel />
    </Design.DataContext>

    <Button
        Grid.Row="2"
        Margin="{DynamicResource ContentMargin}"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        Command="{Binding ExecuteSignalCommand}">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
            <TextBlock
                Grid.Row="0"
                Grid.Column="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="{DynamicResource ContentFontSize}"
                Text="{Binding Artist}" />
            <TextBlock
                Grid.Row="1"
                Grid.Column="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="{DynamicResource ContentFontSize}"
                FontWeight="Bold"
                Text="{Binding Title}" />
            <Grid Grid.Row="2" Grid.Column="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    FontSize="{StaticResource StateFontSize}"
                    Text="{Binding Remaining}" />
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    FontSize="{StaticResource StateFontSize}"
                    Text="{Binding Counter}" />
            </Grid>
        </Grid>
    </Button>
</UserControl>