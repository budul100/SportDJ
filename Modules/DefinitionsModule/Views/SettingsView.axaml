<UserControl
    x:Class="SportDJ.Modules.DefinitionsModule.Views.SettingsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ct="using:SportDJ.Shareds.UserControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mat="using:Material.Icons.Avalonia"
    xmlns:vm="using:SportDJ.Modules.DefinitionsModule.ViewModels"
    xmlns:vml="using:SportDJ.Shareds.ViewModelLocator"
    vml:ViewModelLocator.AutoWireViewModel="True"
    x:DataType="vm:SettingsViewModel"
    d:DesignHeight="500"
    d:DesignWidth="300"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Commons/Assets/Ressources.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.Styles>
        <mat:MaterialIconStyles />

        <Style Selector="Button.Swatch">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Button.Swatch.IsSelected">
            <Setter Property="BorderBrush" Value="White" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel
            Margin="{StaticResource ContentMargin}"
            IsEnabled="{Binding IsActive}"
            Spacing="{StaticResource SpacingMedium}">

            <!-- General -->
            <StackPanel Spacing="{StaticResource SpacingSmall}">

                <TextBlock Classes="Section" Text="General" />
                <Separator />

                <TextBlock
                    HorizontalAlignment="Left"
                    Classes="Caption"
                    Text="Name" />

                <TextBox
                    HorizontalAlignment="Stretch"
                    IsTabStop="False"
                    KeyDown="OnNameKeyDown"
                    MaxLength="{Binding MaxLengthName}"
                    Text="{Binding Name, Mode=TwoWay}" />

                <TextBlock
                    HorizontalAlignment="Left"
                    Classes="Caption"
                    Text="Color" />

                <ItemsControl ItemsSource="{Binding Colors}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ColorOptionViewModel">
                            <Button
                                Background="{Binding Brush}"
                                Classes="Swatch"
                                Classes.IsSelected="{Binding IsSelected}"
                                Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).SelectColorCommand}"
                                CommandParameter="{Binding ColorType}"
                                Focusable="False"
                                ToolTip.Tip="{Binding Name}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>

            <!-- Playback -->
            <StackPanel Spacing="{StaticResource SpacingSmall}">

                <TextBlock Classes="Section" Text="Playback" />
                <Separator />

                <CheckBox
                    HorizontalAlignment="Left"
                    Content="Is overlay signal"
                    IsChecked="{Binding IsOverlay}"
                    IsTabStop="False" />

                <CheckBox
                    HorizontalAlignment="Left"
                    Content="Reset player at start"
                    IsChecked="{Binding IsReset}"
                    IsTabStop="False" />

            </StackPanel>

            <!-- Keyboard -->
            <StackPanel Spacing="{StaticResource SpacingSmall}">

                <TextBlock Classes="Section" Text="Keyboard" />
                <Separator />

                <TextBlock
                    HorizontalAlignment="Left"
                    Classes="Caption"
                    Text="Key" />

                <ct:KeyDisplay
                    HorizontalAlignment="Left"
                    FontSize="{StaticResource FontSizeContentSub}"
                    IsVisible="{Binding HasKey}"
                    KeyCode="{Binding KeyCode}" />

                <TextBlock IsVisible="{Binding !HasKey}" Text="{Binding KeyboardText}" />

                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingMedium}">
                    <Button
                        Click="OnListenClick"
                        Command="{Binding ListenKeyboardCommand}"
                        Focusable="False"
                        ToolTip.Tip="Assign key">
                        <Panel>
                            <mat:MaterialIcon
                                Width="{StaticResource MediumIconSize}"
                                Height="{StaticResource MediumIconSize}"
                                IsVisible="{Binding !IsListeningKeyboard}"
                                Kind="KeyboardOutline" />
                            <mat:MaterialIcon
                                Width="{StaticResource MediumIconSize}"
                                Height="{StaticResource MediumIconSize}"
                                IsVisible="{Binding IsListeningKeyboard}"
                                Kind="Close" />
                        </Panel>
                    </Button>
                    <Button
                        Command="{Binding ClearKeyboardCommand}"
                        Focusable="False"
                        ToolTip.Tip="Clear key">
                        <mat:MaterialIcon
                            Width="{StaticResource MediumIconSize}"
                            Height="{StaticResource MediumIconSize}"
                            Kind="KeyboardOffOutline" />
                    </Button>
                </StackPanel>

            </StackPanel>

            <!-- MIDI -->
            <StackPanel Spacing="{StaticResource SpacingSmall}">

                <TextBlock Classes="Section" Text="MIDI" />
                <Separator />

                <TextBlock
                    HorizontalAlignment="Left"
                    Classes="Caption"
                    Text="Key" />

                <TextBlock Text="{Binding MidiText}" />

                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingMedium}">
                    <Button
                        Command="{Binding ListenMidiCommand}"
                        Focusable="False"
                        ToolTip.Tip="Assign MIDI key">
                        <Panel>
                            <mat:MaterialIcon
                                Width="{StaticResource MediumIconSize}"
                                Height="{StaticResource MediumIconSize}"
                                IsVisible="{Binding !IsListeningMidi}"
                                Kind="Piano" />
                            <mat:MaterialIcon
                                Width="{StaticResource MediumIconSize}"
                                Height="{StaticResource MediumIconSize}"
                                IsVisible="{Binding IsListeningMidi}"
                                Kind="Close" />
                        </Panel>
                    </Button>
                    <Button
                        Command="{Binding ClearMidiCommand}"
                        Focusable="False"
                        ToolTip.Tip="Clear MIDI key">
                        <mat:MaterialIcon
                            Width="{StaticResource MediumIconSize}"
                            Height="{StaticResource MediumIconSize}"
                            Kind="Close" />
                    </Button>
                </StackPanel>

            </StackPanel>

            <!-- Remove -->
            <StackPanel Spacing="{StaticResource SpacingSmall}">

                <TextBlock Classes="Section" Text="Remove" />
                <Separator />

                <Button
                    HorizontalAlignment="Left"
                    Command="{Binding RemoveCommand}"
                    Focusable="False"
                    ToolTip.Tip="Remove player">
                    <mat:MaterialIcon
                        Width="{StaticResource MediumIconSize}"
                        Height="{StaticResource MediumIconSize}"
                        Kind="Delete" />
                </Button>

            </StackPanel>

        </StackPanel>
    </ScrollViewer>

</UserControl>
