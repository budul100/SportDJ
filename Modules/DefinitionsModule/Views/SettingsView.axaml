<UserControl
    x:Class="SportDJ.Modules.DefinitionsModule.Views.SettingsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mat="using:Material.Icons.Avalonia"
    xmlns:vm="using:SportDJ.Modules.DefinitionsModule.ViewModels"
    xmlns:vml="using:SportDJ.Shareds.ViewModelLocator"
    vml:ViewModelLocator.AutoWireViewModel="True"
    x:DataType="vm:SettingsViewModel"
    d:DesignHeight="500"
    d:DesignWidth="300"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Commons/Assets/Ressources.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.Styles>
        <mat:MaterialIconStyles />
    </UserControl.Styles>

    <StackPanel
        Margin="{StaticResource ContentMargin}"
        IsEnabled="{Binding IsActive}"
        Spacing="{StaticResource SpacingMedium}">

        <StackPanel Spacing="{StaticResource SpacingSmall}">

            <TextBlock
                HorizontalAlignment="Left"
                Classes="Caption"
                Text="Player name" />

            <TextBox
                HorizontalAlignment="Stretch"
                IsTabStop="False"
                MaxLength="{Binding MaxLengthName}"
                Text="{Binding Name, Mode=TwoWay}" />

        </StackPanel>

        <StackPanel Spacing="{StaticResource SpacingSmall}">

            <CheckBox
                HorizontalAlignment="Left"
                IsTabStop="False"
                Content="Is overlay signal"
                IsChecked="{Binding IsOverlay}" />

            <CheckBox
                HorizontalAlignment="Left"
                IsTabStop="False"
                Content="Reset player at start"
                IsChecked="{Binding IsReset}" />

        </StackPanel>

        <StackPanel
            HorizontalAlignment="Left"
            Orientation="Horizontal"
            Spacing="{StaticResource SpacingMedium}">

            <Button Content="Register" Command="{Binding RegisterCommand}" />
            <Button Content="Unregister" Command="{Binding UnregisterCommand}" />

        </StackPanel>

    </StackPanel>

</UserControl>
