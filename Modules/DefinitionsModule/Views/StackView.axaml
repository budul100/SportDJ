<UserControl
    x:Class="SportDJ.Modules.DefinitionsModule.Views.StackView"
    x:Name="StackViewControl"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ct="using:SportDJ.Shareds.UserControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dt="using:SportDJ.Modules.DefinitionsModule.DesignTime"
    xmlns:i="using:Avalonia.Xaml.Interactivity"
    xmlns:ia="using:Avalonia.Xaml.Interactions.Core"
    xmlns:mat="using:Material.Icons.Avalonia"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:SportDJ.Commons.Models.Contents"
    xmlns:vm="using:SportDJ.Modules.DefinitionsModule.ViewModels"
    xmlns:vml="using:SportDJ.Shareds.ViewModelLocator"
    vml:ViewModelLocator.AutoWireViewModel="True"
    x:DataType="vm:StackViewModel"
    d:DesignHeight="500"
    d:DesignWidth="300"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Commons/Assets/Ressources.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.Styles>
        <mat:MaterialIconStyles />

        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="{StaticResource InnerMargin}" />
        </Style>

        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </UserControl.Styles>

    <Design.DataContext>
        <dt:StackViewModel />
    </Design.DataContext>

    <DockPanel Margin="{StaticResource ContentMargin}" LastChildFill="True">

        <Grid
            Margin="{StaticResource InnerMargin}"
            ColumnDefinitions="*,*"
            DockPanel.Dock="Top">
            <Button
                Grid.Column="0"
                Margin="{StaticResource InnerMargin}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Command="{Binding ResetCommand}"
                Focusable="False"
                ToolTip.Tip="Reset played">
                <mat:MaterialIcon
                    Width="{StaticResource MediumIconSize}"
                    Height="{StaticResource MediumIconSize}"
                    Kind="History" />
            </Button>
            <Button
                Grid.Column="1"
                Margin="{StaticResource InnerMargin}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Command="{Binding ShuffleCommand}"
                Focusable="False"
                ToolTip.Tip="Shuffle">
                <mat:MaterialIcon
                    Width="{StaticResource MediumIconSize}"
                    Height="{StaticResource MediumIconSize}"
                    Kind="ShuffleVariant" />
            </Button>
        </Grid>

        <!-- Declared before the list, otherwise the last child fill would swallow the dock -->
        <Grid
            Margin="{StaticResource InnerMargin}"
            ColumnDefinitions="*,*,*"
            DockPanel.Dock="Bottom">
            <Button
                Grid.Column="0"
                Margin="{StaticResource InnerMargin}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Command="{Binding LoadFilesCommand}"
                Focusable="False"
                ToolTip.Tip="Add files">
                <mat:MaterialIcon
                    Width="{StaticResource MediumIconSize}"
                    Height="{StaticResource MediumIconSize}"
                    Kind="FileMultipleOutline" />
            </Button>
            <Button
                Grid.Column="1"
                Margin="{StaticResource InnerMargin}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Command="{Binding LoadFolderCommand}"
                Focusable="False"
                ToolTip.Tip="Add folder">
                <mat:MaterialIcon
                    Width="{StaticResource MediumIconSize}"
                    Height="{StaticResource MediumIconSize}"
                    Kind="FolderMultipleOutline" />
            </Button>
            <Button
                Grid.Column="2"
                Margin="{StaticResource InnerMargin}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Command="{Binding ClearCommand}"
                Focusable="False"
                ToolTip.Tip="Clear player">
                <mat:MaterialIcon
                    Width="{StaticResource MediumIconSize}"
                    Height="{StaticResource MediumIconSize}"
                    Kind="CloseCircleOutline" />
            </Button>
        </Grid>

        <ListBox
            Margin="{StaticResource InnerMargin}"
            ItemsSource="{Binding Entries}"
            SelectedItem="{Binding Entry, Mode=TwoWay}"
            AutoScrollToSelectedItem="{Binding AutoScroll}">

            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="models:Entry">
                    <ct:EntryView
                        Entry="{Binding}"
                        EventAggregator="{Binding #StackViewControl.((vm:StackViewModel)DataContext).EventAggregator}">
                    </ct:EntryView>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

    </DockPanel>
</UserControl>
