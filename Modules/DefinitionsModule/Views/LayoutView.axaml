<UserControl
    x:Class="SportDJ.Modules.DefinitionsModule.Views.LayoutView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:enums="using:SportDJ.Commons.Enums"
    xmlns:mat="using:Material.Icons.Avalonia"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:SportDJ.Modules.DefinitionsModule.Views"
    xmlns:vm="using:SportDJ.Modules.DefinitionsModule.ViewModels"
    xmlns:vml="using:SportDJ.Shareds.ViewModelLocator"
    vml:ViewModelLocator.AutoWireViewModel="True"
    x:DataType="vm:LayoutViewModel"
    d:DesignHeight="500"
    d:DesignWidth="300"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Commons/Assets/Ressources.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.Styles>
        <mat:MaterialIconStyles />
    </UserControl.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel
            Margin="{StaticResource ContentMargin}"
            IsEnabled="{Binding IsActive}"
            Spacing="{StaticResource SpacingMedium}">

            <!-- Order: move tab, move, remove, add tab, add player, group. The tab parts are only shown if the pane was opened from a tab of a group -->

            <!-- Move tab -->
            <StackPanel IsVisible="{Binding IsTab}" Spacing="{StaticResource SpacingSmall}">

                <TextBlock Classes="Section" Text="Move tab" />
                <Separator />

                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingMedium}">
                    <Button
                        Command="{Binding MoveTabCommand}"
                        CommandParameter="{x:Static enums:OrientationType.Left}"
                        Focusable="False"
                        ToolTip.Tip="Move tab to the left">
                        <mat:MaterialIcon Width="18" Height="18" Kind="ArrowLeft" />
                    </Button>
                    <Button
                        Command="{Binding MoveTabCommand}"
                        CommandParameter="{x:Static enums:OrientationType.Right}"
                        Focusable="False"
                        ToolTip.Tip="Move tab to the right">
                        <mat:MaterialIcon Width="18" Height="18" Kind="ArrowRight" />
                    </Button>
                </StackPanel>

            </StackPanel>

            <!-- Move -->
            <StackPanel Spacing="{StaticResource SpacingSmall}">

                <TextBlock Classes="Section" Text="Move" />
                <Separator />

                <views:DirectionCross
                    HorizontalAlignment="Left"
                    CenterKind="ArrowAll"
                    Command="{Binding MoveCellCommand}" />

            </StackPanel>

            <!-- Remove: the player or the tab, whatever the pane was opened from. Dark red, on the right edge -->
            <StackPanel Spacing="{StaticResource SpacingSmall}">

                <TextBlock Classes="Section" Text="Remove" />
                <Separator />

                <Button
                    HorizontalAlignment="Right"
                    Classes="Danger"
                    Command="{Binding RemoveCellCommand}"
                    Focusable="False"
                    IsVisible="{Binding IsPlayer}"
                    ToolTip.Tip="Remove player">
                    <mat:MaterialIcon
                        Width="{StaticResource MediumIconSize}"
                        Height="{StaticResource MediumIconSize}"
                        Kind="Delete" />
                </Button>

                <Button
                    HorizontalAlignment="Right"
                    Classes="Danger"
                    Command="{Binding RemoveTabCommand}"
                    Focusable="False"
                    IsVisible="{Binding IsTab}"
                    ToolTip.Tip="Remove tab">
                    <mat:MaterialIcon
                        Width="{StaticResource MediumIconSize}"
                        Height="{StaticResource MediumIconSize}"
                        Kind="Delete" />
                </Button>

            </StackPanel>

            <!-- Add tab -->
            <StackPanel IsVisible="{Binding IsTab}" Spacing="{StaticResource SpacingSmall}">

                <TextBlock Classes="Section" Text="Add tab" />
                <Separator />

                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingMedium}">
                    <Button
                        Command="{Binding AddTabCommand}"
                        CommandParameter="{x:Static enums:OrientationType.Left}"
                        Focusable="False"
                        ToolTip.Tip="Add tab to the left">
                        <StackPanel Orientation="Horizontal">
                            <mat:MaterialIcon Width="18" Height="18" Kind="ArrowLeft" />
                            <mat:MaterialIcon Width="18" Height="18" Kind="Plus" />
                        </StackPanel>
                    </Button>
                    <Button
                        Command="{Binding AddTabCommand}"
                        CommandParameter="{x:Static enums:OrientationType.Right}"
                        Focusable="False"
                        ToolTip.Tip="Add tab to the right">
                        <StackPanel Orientation="Horizontal">
                            <mat:MaterialIcon Width="18" Height="18" Kind="Plus" />
                            <mat:MaterialIcon Width="18" Height="18" Kind="ArrowRight" />
                        </StackPanel>
                    </Button>
                </StackPanel>

            </StackPanel>

            <!-- Add player -->
            <StackPanel Spacing="{StaticResource SpacingSmall}">

                <TextBlock Classes="Section" Text="Add player" />
                <Separator />

                <views:DirectionCross
                    HorizontalAlignment="Left"
                    CenterKind="Plus"
                    Command="{Binding AddCellCommand}" />

            </StackPanel>

            <!-- Group: puts the player into a new group, only for players -->
            <StackPanel IsVisible="{Binding IsPlayer}" Spacing="{StaticResource SpacingSmall}">

                <TextBlock Classes="Section" Text="Group" />
                <Separator />

                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingMedium}">

                    <Button
                        Command="{Binding GroupCommand}"
                        Focusable="False"
                        ToolTip.Tip="Put player into a new group">
                        <mat:MaterialIcon
                            Width="{StaticResource MediumIconSize}"
                            Height="{StaticResource MediumIconSize}"
                            Kind="Tab" />
                    </Button>

                    <!-- Shows the group, which the player belongs to, hidden without a group -->
                    <TextBlock
                        VerticalAlignment="Center"
                        Classes="Caption"
                        IsVisible="{Binding HasGroup}"
                        Text="{Binding GroupText, StringFormat='Group: {0}'}"
                        TextTrimming="CharacterEllipsis" />

                </StackPanel>

            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
