<UserControl
    x:Class="SportDJ.Modules.DefinitionsModule.Views.LayoutView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:enums="using:SportDJ.Commons.Enums"
    xmlns:mat="using:Material.Icons.Avalonia"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:SportDJ.Modules.DefinitionsModule.Views"
    xmlns:vm="using:SportDJ.Modules.DefinitionsModule.ViewModels"
    xmlns:vml="using:SportDJ.Shareds.ViewModelLocator"
    vml:ViewModelLocator.AutoWireViewModel="True"
    x:DataType="vm:LayoutViewModel"
    d:DesignHeight="500"
    d:DesignWidth="300"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Commons/Assets/Ressources.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.Styles>
        <mat:MaterialIconStyles />
    </UserControl.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel
            Margin="{StaticResource ContentMargin}"
            IsEnabled="{Binding IsActive}"
            Spacing="{StaticResource SpacingMedium}">

            <!-- Tab, only if the pane was opened from a tab of a group -->
            <StackPanel IsVisible="{Binding IsTab}" Spacing="{StaticResource SpacingMedium}">

                <StackPanel Spacing="{StaticResource SpacingSmall}">

                    <TextBlock Classes="Section" Text="Add tab" />
                    <Separator />

                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingMedium}">
                        <Button
                            Command="{Binding AddTabCommand}"
                            CommandParameter="{x:Static enums:OrientationType.Left}"
                            Focusable="False"
                            ToolTip.Tip="Add tab to the left">
                            <StackPanel Orientation="Horizontal">
                                <mat:MaterialIcon Width="18" Height="18" Kind="ArrowLeft" />
                                <mat:MaterialIcon Width="18" Height="18" Kind="Plus" />
                            </StackPanel>
                        </Button>
                        <Button
                            Command="{Binding AddTabCommand}"
                            CommandParameter="{x:Static enums:OrientationType.Right}"
                            Focusable="False"
                            ToolTip.Tip="Add tab to the right">
                            <StackPanel Orientation="Horizontal">
                                <mat:MaterialIcon Width="18" Height="18" Kind="Plus" />
                                <mat:MaterialIcon Width="18" Height="18" Kind="ArrowRight" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                </StackPanel>

                <StackPanel Spacing="{StaticResource SpacingSmall}">

                    <TextBlock Classes="Section" Text="Move tab" />
                    <Separator />

                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingMedium}">
                        <Button
                            Command="{Binding MoveTabCommand}"
                            CommandParameter="{x:Static enums:OrientationType.Left}"
                            Focusable="False"
                            ToolTip.Tip="Move tab to the left">
                            <mat:MaterialIcon Width="18" Height="18" Kind="ArrowLeft" />
                        </Button>
                        <Button
                            Command="{Binding MoveTabCommand}"
                            CommandParameter="{x:Static enums:OrientationType.Right}"
                            Focusable="False"
                            ToolTip.Tip="Move tab to the right">
                            <mat:MaterialIcon Width="18" Height="18" Kind="ArrowRight" />
                        </Button>
                    </StackPanel>

                </StackPanel>

            </StackPanel>

            <!-- Add -->
            <StackPanel Spacing="{StaticResource SpacingSmall}">

                <TextBlock Classes="Section" Text="Add player" />
                <Separator />

                <views:DirectionCross
                    HorizontalAlignment="Left"
                    CenterKind="Plus"
                    Command="{Binding AddCellCommand}" />

            </StackPanel>

            <!-- Move -->
            <StackPanel Spacing="{StaticResource SpacingSmall}">

                <TextBlock Classes="Section" Text="Move" />
                <Separator />

                <views:DirectionCross
                    HorizontalAlignment="Left"
                    CenterKind="ArrowAll"
                    Command="{Binding MoveCellCommand}" />

            </StackPanel>

            <!-- Group: switches between a player and the group -->
            <StackPanel Spacing="{StaticResource SpacingSmall}">

                <TextBlock Classes="Section" Text="Group" />
                <Separator />

                <Button
                    HorizontalAlignment="Left"
                    Command="{Binding SwapCommand}"
                    Focusable="False"
                    ToolTip.Tip="Swap player and group">
                    <mat:MaterialIcon
                        Width="{StaticResource MediumIconSize}"
                        Height="{StaticResource MediumIconSize}"
                        Kind="Tab" />
                </Button>

            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
