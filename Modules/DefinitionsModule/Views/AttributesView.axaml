<UserControl
    x:Class="SportDJ.Modules.DefinitionsModule.Views.AttributesView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mat="using:Material.Icons.Avalonia"
    d:DesignHeight="500"
    d:DesignWidth="300"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude  Source="avares://Commons/Assets/Ressources.axaml" />
            </ResourceDictionary.MergedDictionaries>

            <Thickness x:Key="InnerMargin">2</Thickness>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.Styles>
        <mat:MaterialIconStyles />
    </UserControl.Styles>

    <StackPanel
        IsEnabled="{Binding IsActive}">

        <StackPanel
            Margin="{StaticResource InnerMargin}">

            <TextBlock
                Margin="{StaticResource InnerMargin}"
                HorizontalAlignment="Left"
                VerticalAlignment="Stretch"
                FontSize="{StaticResource FontSizeSettings}"
                Text="Player name" />

            <TextBox
                HorizontalAlignment="Stretch"
                Focusable="False"
                Text="{Binding DeviceInfo}"
                IsReadOnly="True" />

        </StackPanel>

        <CheckBox
            Margin="{StaticResource InnerMargin}"
            HorizontalAlignment="Left"
            VerticalAlignment="Stretch"
            Content="Is foreground player"
            IsChecked="{Binding IsForeground}" />

        <CheckBox
            Margin="{StaticResource InnerMargin}"
            HorizontalAlignment="Left"
            VerticalAlignment="Stretch"
            Content="Reset play at start"
            IsChecked="{Binding IsReset}" />

    </StackPanel>

</UserControl>
