<UserControl
    x:Class="SportDJ.Modules.DefinitionsModule.Views.DefinitionsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:designtime="using:SportDJ.Modules.DefinitionsModule.DesignTime"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:SportDJ.Modules.DefinitionsModule.Views"
    xmlns:vm="using:SportDJ.Modules.DefinitionsModule.ViewModels"
    xmlns:vml="using:SportDJ.Shareds.ViewModelLocator"
    vml:ViewModelLocator.AutoWireViewModel="True"
    x:DataType="vm:DefinitionsViewModel"
    d:DesignHeight="500"
    d:DesignWidth="300"
    mc:Ignorable="d">

    <TabControl
        ItemsSource="{Binding Tabs}"
        SelectedItem="{Binding Active}"
        MinHeight="200">

        <TabControl.ItemTemplate>
            <DataTemplate x:DataType="vm:TabViewModel">
                <TextBlock Text="{Binding Title}"/>
            </DataTemplate>
        </TabControl.ItemTemplate>

        <TabControl.ContentTemplate>
            <DataTemplate x:DataType="vm:TabViewModel">
                <ContentControl Content="{Binding}">
                    <ContentControl.DataTemplates>

                        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                            <views:SettingsView/>
                        </DataTemplate>

                        <DataTemplate DataType="{x:Type vm:StackViewModel}">
                            <views:StackView/>
                        </DataTemplate>

                    </ContentControl.DataTemplates>
                </ContentControl>
            </DataTemplate>
        </TabControl.ContentTemplate>

    </TabControl>
</UserControl>
