<UserControl
    x:Class="SportDJ.Modules.DefinitionsModule.Views.TabSettingsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ct="using:SportDJ.Shareds.UserControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mat="using:Material.Icons.Avalonia"
    xmlns:vm="using:SportDJ.Modules.DefinitionsModule.ViewModels"
    xmlns:vml="using:SportDJ.Shareds.ViewModelLocator"
    vml:ViewModelLocator.AutoWireViewModel="True"
    x:DataType="vm:TabSettingsViewModel"
    d:DesignHeight="500"
    d:DesignWidth="300"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Commons/Assets/Ressources.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.Styles>
        <mat:MaterialIconStyles />
    </UserControl.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel
            Margin="{StaticResource ContentMargin}"
            IsEnabled="{Binding IsActive}"
            Spacing="{StaticResource SpacingMedium}">

            <!-- General: the name is on the left, the key and its buttons are on the right edge of the same row -->
            <StackPanel Spacing="{StaticResource SpacingSmall}">

                <TextBlock Classes="Section" Text="General" />
                <Separator />

                <TextBlock
                    HorizontalAlignment="Left"
                    Classes="Caption"
                    Text="Name and key" />

                <Grid ColumnDefinitions="*,Auto">

                    <TextBox
                        Grid.Column="0"
                        Margin="0,0,4,0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        IsTabStop="False"
                        KeyDown="OnNameKeyDown"
                        MaxLength="{Binding MaxLengthName}"
                        Text="{Binding Name, Mode=TwoWay}" />

                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="{StaticResource SpacingSmall}">

                        <ct:KeyDisplay
                            VerticalAlignment="Center"
                            FontSize="{StaticResource FontSizeState}"
                            IsVisible="{Binding HasKey}"
                            KeyCode="{Binding KeyCode}" />

                        <Button
                            Click="OnListenClick"
                            Command="{Binding ListenKeyboardCommand}"
                            Focusable="False"
                            ToolTip.Tip="Assign key">
                            <Panel>
                                <mat:MaterialIcon
                                    Width="{StaticResource MediumIconSize}"
                                    Height="{StaticResource MediumIconSize}"
                                    IsVisible="{Binding !IsListeningKeyboard}"
                                    Kind="KeyboardOutline" />
                                <mat:MaterialIcon
                                    Width="{StaticResource MediumIconSize}"
                                    Height="{StaticResource MediumIconSize}"
                                    IsVisible="{Binding IsListeningKeyboard}"
                                    Kind="Close" />
                            </Panel>
                        </Button>

                        <Button
                            Command="{Binding ClearKeyboardCommand}"
                            Focusable="False"
                            ToolTip.Tip="Clear key">
                            <mat:MaterialIcon
                                Width="{StaticResource MediumIconSize}"
                                Height="{StaticResource MediumIconSize}"
                                Kind="KeyboardOffOutline" />
                        </Button>
                    </StackPanel>
                </Grid>

            </StackPanel>

            <!-- Remove -->
            <StackPanel Spacing="{StaticResource SpacingSmall}">

                <TextBlock Classes="Section" Text="Remove" />
                <Separator />

                <!-- Dark red, on the right edge -->
                <Button
                    HorizontalAlignment="Right"
                    Classes="Danger"
                    Command="{Binding RemoveCommand}"
                    Focusable="False"
                    ToolTip.Tip="Remove tab">
                    <mat:MaterialIcon
                        Width="{StaticResource MediumIconSize}"
                        Height="{StaticResource MediumIconSize}"
                        Kind="Delete" />
                </Button>

            </StackPanel>

        </StackPanel>
    </ScrollViewer>

</UserControl>