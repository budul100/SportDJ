<UserControl
    x:Class="SportDJ.Modules.SettingsModule.Views.SettingsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dt="using:SportDJ.Modules.SettingsModule.DesignTime"
    xmlns:mat="using:Material.Icons.Avalonia"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:rec="using:SportDJ.Commons.Models.Records"
    xmlns:pgc="clr-namespace:Avalonia.PropertyGrid.Controls;assembly=Avalonia.PropertyGrid"
    xmlns:vm="using:SportDJ.Modules.SettingsModule.ViewModels"
    xmlns:vml="using:SportDJ.Shareds.ViewModelLocator"
    d:DesignHeight="500"
    d:DesignWidth="300"
    vml:ViewModelLocator.AutoWireViewModel="True"
    x:DataType="vm:SettingsViewModel"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Commons/Assets/Ressources.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.Styles>
        <mat:MaterialIconStyles />
    </UserControl.Styles>

    <Design.DataContext>
        <dt:SettingsViewModel />
    </Design.DataContext>

    <DockPanel IsEnabled="{Binding IsActive}" LastChildFill="True">

        <!-- Output device -->
        <DockPanel
            Margin="{StaticResource ContentMargin}"
            DockPanel.Dock="Top"
            IsEnabled="{Binding !DevicesNotAvailable}"
            LastChildFill="True">

            <Button
                Margin="{StaticResource InnerMargin}"
                VerticalAlignment="Bottom"
                Classes="Tool"
                Command="{Binding UpdateDevicesCommand}"
                DockPanel.Dock="Right"
                Focusable="False">
                <mat:MaterialIcon
                    Width="{StaticResource MediumIconSize}"
                    Height="{StaticResource MediumIconSize}"
                    Kind="Reload" />
            </Button>

            <StackPanel
                Margin="{StaticResource InnerMargin}"
                DockPanel.Dock="Left"
                Spacing="{StaticResource SpacingSmall}">

                <TextBlock
                    HorizontalAlignment="Left"
                    Classes="Caption"
                    Text="Output device" />

                <ComboBox
                    HorizontalAlignment="Stretch"
                    Focusable="False"
                    ItemsSource="{Binding Devices}"
                    SelectedItem="{Binding Device}"
                    Classes.error="{Binding Device, Converter={x:Static ObjectConverters.IsNull}}">

                    <ComboBox.Styles>
                        <Style Selector="ComboBox.error">
                            <Setter Property="BorderBrush" Value="Red" />
                        </Style>
                    </ComboBox.Styles>

                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="rec:Device">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingMedium}">
                                <TextBlock Text="{Binding Name}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Classes="Caption"
                                    Text="{Binding Type, Converter={StaticResource CapabilityTypeConverter}}" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>

                </ComboBox>

            </StackPanel>
        </DockPanel>

        <!-- Midi controller -->
        <DockPanel
            Margin="{StaticResource ContentMargin}"
            DockPanel.Dock="Top"
            IsEnabled="{Binding !ControllersNotAvailable}"
            LastChildFill="True">

            <Button
                Margin="{StaticResource InnerMargin}"
                VerticalAlignment="Bottom"
                Classes="Tool"
                Command="{Binding UpdateControllersCommand}"
                DockPanel.Dock="Right"
                Focusable="False">
                <mat:MaterialIcon
                    Width="{StaticResource MediumIconSize}"
                    Height="{StaticResource MediumIconSize}"
                    Kind="Reload" />
            </Button>

            <StackPanel
                Margin="{StaticResource InnerMargin}"
                DockPanel.Dock="Left"
                Spacing="{StaticResource SpacingSmall}">

                <TextBlock
                    HorizontalAlignment="Left"
                    Classes="Caption"
                    Text="Midi controller" />

                <ComboBox
                    HorizontalAlignment="Stretch"
                    Focusable="False"
                    ItemsSource="{Binding Controllers}"
                    SelectedItem="{Binding Controller}">

                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="rec:Controller">
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>

                </ComboBox>

            </StackPanel>
        </DockPanel>

        <!-- Load / save settings -->
        <Grid
            Margin="{StaticResource ContentMargin}"
            ColumnDefinitions="*,*"
            DockPanel.Dock="Bottom">
            <Button
                Grid.Column="0"
                Margin="{StaticResource InnerMargin}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Command="{Binding SettingsLoadCommand}"
                Focusable="False">
                <mat:MaterialIcon
                    Width="{StaticResource MediumIconSize}"
                    Height="{StaticResource MediumIconSize}"
                    Kind="FolderOpenOutline" />
            </Button>
            <Button
                Grid.Column="1"
                Margin="{StaticResource InnerMargin}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Command="{Binding SettingsSaveCommand}"
                Focusable="False">
                <mat:MaterialIcon
                    Width="{StaticResource MediumIconSize}"
                    Height="{StaticResource MediumIconSize}"
                    Kind="ContentSaveOutline" />
            </Button>
        </Grid>

        <pgc:PropertyGrid
            Margin="{StaticResource ContentMargin}"
            IsQuickFilterVisible="False"
            IsHeaderVisible="False"
            IsTitleVisible="False"
            DataContext="{Binding Options}"
            DockPanel.Dock="Bottom"
            Focusable="False" />

        <!-- Volumes -->
        <Grid Margin="{StaticResource ContentMargin}" DockPanel.Dock="Top">

            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
            </Grid.RowDefinitions>

            <TextBlock
                Grid.Row="0"
                Grid.Column="0"
                Margin="{StaticResource InnerMargin}"
                HorizontalAlignment="Center"
                Classes="Caption"
                TextAlignment="Center"
                TextWrapping="Wrap"
                Text="Volume" />

            <Slider
                Grid.Row="1"
                Grid.Column="0"
                Margin="{StaticResource InnerMargin}"
                HorizontalAlignment="Center"
                VerticalAlignment="Stretch"
                Focusable="False"
                IsSnapToTickEnabled="True"
                Maximum="1"
                Minimum="0"
                Orientation="Vertical"
                TickFrequency="0.05"
                Value="{Binding Volume}" />

            <TextBlock
                Grid.Row="0"
                Grid.Column="1"
                Margin="{StaticResource InnerMargin}"
                HorizontalAlignment="Center"
                Classes="Caption"
                TextAlignment="Center"
                TextWrapping="Wrap"
                Text="Background" />

            <Slider
                Grid.Row="1"
                Grid.Column="1"
                Margin="{StaticResource InnerMargin}"
                HorizontalAlignment="Center"
                VerticalAlignment="Stretch"
                Focusable="False"
                IsSnapToTickEnabled="True"
                TickFrequency="5"
                Maximum="100"
                Minimum="0"
                Orientation="Vertical"
                Value="{Binding VolumePercentageBackground}" />

            <TextBlock
                Grid.Row="0"
                Grid.Column="2"
                Margin="{StaticResource InnerMargin}"
                HorizontalAlignment="Center"
                Classes="Caption"
                TextAlignment="Center"
                TextWrapping="Wrap"
                Text="External apps" />

            <Slider
                Grid.Row="1"
                Grid.Column="2"
                Margin="{StaticResource InnerMargin}"
                HorizontalAlignment="Center"
                VerticalAlignment="Stretch"
                Focusable="False"
                IsSnapToTickEnabled="True"
                Maximum="100"
                Minimum="0"
                Orientation="Vertical"
                TickFrequency="5"
                Value="{Binding VolumePercentageExternals}" />
        </Grid>
    </DockPanel>
</UserControl>
