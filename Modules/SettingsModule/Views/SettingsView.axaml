<UserControl
    x:Class="SportDJ.Modules.SettingsModule.Views.SettingsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:a="clr-namespace:Avalonia.Xaml.Interactions.Core;assembly=Avalonia.Xaml.Interactions"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dt="using:SportDJ.Modules.SettingsModule.DesignTime"
    xmlns:i="clr-namespace:Avalonia.Xaml.Interactivity;assembly=Avalonia.Xaml.Interactivity"
    xmlns:mat="using:Material.Icons.Avalonia"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pgc="clr-namespace:Avalonia.PropertyGrid.Controls;assembly=Avalonia.PropertyGrid"
    xmlns:prism="http://prismlibrary.com/"
    d:DesignHeight="500"
    d:DesignWidth="100"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">

    <UserControl.Resources>

        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Commons/Assets/Ressources.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>

        <Thickness x:Key="InnerMargin">2</Thickness>

        <x:Double x:Key="IconWidth">30</x:Double>
        <x:Double x:Key="IconHeight">30</x:Double>
    </UserControl.Resources>

    <UserControl.Styles>
        <mat:MaterialIconStyles />
    </UserControl.Styles>

    <Design.DataContext>
        <dt:SettingsViewModel />
    </Design.DataContext>

    <DockPanel LastChildFill="True">

        <DockPanel
            Margin="{StaticResource ContentMargin}"
            DockPanel.Dock="Top"
            LastChildFill="True">

            <Button
                Margin="{StaticResource InnerMargin}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Command="{Binding UpdateDevicesCommand}"
                DockPanel.Dock="Right">
                <mat:MaterialIcon
                    Width="{StaticResource IconWidth}"
                    Height="{StaticResource IconHeight}"
                    Kind="Reload" />
            </Button>

            <StackPanel Margin="{StaticResource InnerMargin}" DockPanel.Dock="Left">

                <TextBlock
                    Margin="{StaticResource InnerMargin}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Stretch"
                    FontSize="{StaticResource FontSizeVolume}"
                    Text="Output device" />
                <ComboBox
                    Margin="{StaticResource InnerMargin}"
                    HorizontalAlignment="Stretch"
                    IsEnabled="{Binding !DevicesNotAvailable}"
                    ItemsSource="{Binding Devices}"
                    SelectedItem="{Binding Device}" />
            </StackPanel>
        </DockPanel>

        <pgc:PropertyGrid
            Margin="{StaticResource ContentMargin}"
            AllowFilter="False"
            AllowQuickFilter="False"
            AllowToggleView="False"
            DataContext="{Binding Options}"
            DockPanel.Dock="Bottom" />

        <Grid Margin="{StaticResource ContentMargin}" DockPanel.Dock="Top">

            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="30" />
                <RowDefinition />
            </Grid.RowDefinitions>

            <TextBlock
                Grid.Row="0"
                Grid.Column="0"
                Margin="{StaticResource InnerMargin}"
                HorizontalAlignment="Center"
                VerticalAlignment="Stretch"
                FontSize="{StaticResource FontSizeVolume}"
                Text="Volume" />

            <Slider
                Grid.Row="1"
                Grid.Column="0"
                Margin="{StaticResource InnerMargin}"
                HorizontalAlignment="Center"
                VerticalAlignment="Stretch"
                Maximum="1"
                Minimum="0"
                Orientation="Vertical"
                Value="{Binding Volume}" />

            <TextBlock
                Grid.Row="0"
                Grid.Column="1"
                Margin="{StaticResource InnerMargin}"
                HorizontalAlignment="Center"
                VerticalAlignment="Stretch"
                FontSize="{StaticResource FontSizeVolume}"
                Text="Background" />

            <Slider
                Grid.Row="1"
                Grid.Column="1"
                Margin="{StaticResource InnerMargin}"
                HorizontalAlignment="Center"
                VerticalAlignment="Stretch"
                Maximum="1"
                Minimum="0"
                Orientation="Vertical"
                Value="{Binding VolumePortionBackground}" />

            <TextBlock
                Grid.Row="0"
                Grid.Column="2"
                Margin="{StaticResource InnerMargin}"
                HorizontalAlignment="Center"
                VerticalAlignment="Stretch"
                FontSize="{StaticResource FontSizeVolume}"
                Text="Apps" />

            <Slider
                Grid.Row="1"
                Grid.Column="2"
                Margin="{StaticResource InnerMargin}"
                HorizontalAlignment="Center"
                VerticalAlignment="Stretch"
                Maximum="1"
                Minimum="0"
                Orientation="Vertical"
                Value="{Binding VolumePortionApps}" />
        </Grid>
    </DockPanel>
</UserControl>