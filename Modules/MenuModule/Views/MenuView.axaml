<UserControl
	x:Class="SportDJ.Modules.MenuModule.Views.MenuView"
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:v="using:SportDJ.Modules.MenuModule.Views"
	xmlns:vm="using:SportDJ.Modules.MenuModule.ViewModels"
	d:DesignHeight="450"
	d:DesignWidth="800"
	mc:Ignorable="d">

	<ContentControl>
		<ContextMenu
			IsVisible="{Binding IsAvailableMenu}"
			ItemsSource="{Binding MenuItems}"
			Opened="OnContextMenuOpened">

			<ContextMenu.DataTemplates>
				<DataTemplate x:DataType="vm:ItemViewModel">
					<v:ItemView />
				</DataTemplate>
				<DataTemplate x:DataType="vm:SeparatorViewModel">
					<Separator />
				</DataTemplate>
			</ContextMenu.DataTemplates>
		</ContextMenu>
	</ContentControl>
</UserControl>