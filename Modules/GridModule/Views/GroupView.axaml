<UserControl
    x:Class="SportDJ.Modules.GridModule.Views.GroupView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:assets="using:SportDJ.Commons.Assets"
    xmlns:ct="using:SportDJ.Shareds.UserControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dt="using:SportDJ.Modules.GridModule.DesignTime"
    xmlns:mat="using:Material.Icons.Avalonia"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:v="using:SportDJ.Modules.GridModule.Views"
    xmlns:vm="using:SportDJ.Modules.GridModule.ViewModels"
    d:DesignHeight="300"
    d:DesignWidth="500"
    x:DataType="vm:GroupViewModel"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Commons/Assets/Ressources.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.Styles>
        <mat:MaterialIconStyles />
    </UserControl.Styles>

    <Design.DataContext>
        <dt:GroupViewModel />
    </Design.DataContext>

    <!--
        No margin here: the cell of the group must be exactly as large as the cell of a player,
        so the nested players keep the same distance to their neighbours.
        The inset of the tab headers is defined in Styles.axaml (TabItem).
    -->
    <TabControl
        Focusable="False"
        ItemsSource="{Binding Tabs}"
        SelectedItem="{Binding Selected}">

        <TabControl.ItemTemplate>
            <DataTemplate x:DataType="vm:GridViewModel">

                <!-- The looks of TabHeader and KeyBadge are defined in Styles.axaml -->
                <Border
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Classes="TabHeader"
                    IsTabStop="False"
                    Focusable="False">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="{Binding HasKey, Converter={StaticResource BoolToGridSizeAutoConverter}}" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Viewbox
                            Grid.Column="0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Focusable="False"
                            Stretch="Uniform"
                            StretchDirection="DownOnly">

                            <ct:EditableText
                                Margin="{StaticResource GroupTabMargin}"
                                FontSize="{StaticResource FontSizeContentSub}"
                                FontWeight="{StaticResource FontWeightTitle}"
                                IsActive="{Binding IsRenaming}"
                                MaxLength="{x:Static assets:Constants.NameMaxLength}"
                                Text="{Binding Name}" />
                        </Viewbox>

                        <Viewbox
                            Grid.Column="1"
                            Margin="{StaticResource KeyMargin}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Focusable="False"
                            IsVisible="{Binding HasKey}"
                            Stretch="Uniform"
                            StretchDirection="DownOnly">

                            <Border Classes="KeyBadge">
                                <TextBlock
                                    FontSize="{StaticResource FontSizeState}"
                                    Text="{Binding Key}" />
                            </Border>
                        </Viewbox>

                        <!-- Opens the layout pane of this tab -->
                        <Button
                            Grid.Column="2"
                            Margin="{StaticResource KeyMargin}"
                            Padding="2"
                            VerticalAlignment="Center"
                            Command="{Binding ShowLayoutCommand}"
                            Focusable="False"
                            ToolTip.Tip="Layout">
                            <mat:MaterialIcon
                                Width="{StaticResource FontSizeState}"
                                Height="{StaticResource FontSizeState}"
                                Kind="Build" />
                        </Button>
                    </Grid>
                </Border>
            </DataTemplate>
        </TabControl.ItemTemplate>

        <TabControl.ContentTemplate>
            <DataTemplate x:DataType="vm:GridViewModel">
                <v:GridView />
            </DataTemplate>
        </TabControl.ContentTemplate>
    </TabControl>
</UserControl>
