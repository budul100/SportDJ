<UserControl
    x:Class="SportDJ.Modules.GridModule.Views.GroupView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:co="using:SportDJ.Commons.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dt="using:SportDJ.Modules.GridModule.DesignTime"
    xmlns:gbac="using:GroupBox.Avalonia.Controls"
    xmlns:gbact="using:GroupBox.Avalonia.ControlThemes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:v="using:SportDJ.Modules.GridModule.Views"
    xmlns:vm="using:SportDJ.Modules.GridModule.ViewModels"
    d:DesignHeight="300"
    d:DesignWidth="300"
    prism:ViewModelLocator.AutoWireViewModel="False"
    mc:Ignorable="d">

    <UserControl.Resources>

        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Commons/Assets/Ressources.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>

        <Thickness x:Key="InnerMargin">1</Thickness>
        <Thickness x:Key="TabMargin">30,10,30,10</Thickness>
        <Thickness x:Key="KeyMargin">5</Thickness>

        <co:BoolToGridSizeAutoConverter x:Key="BoolToGridSizeAutoConverter" />
        <co:BoolToGridSizeStarConverter x:Key="BoolToGridSizeStarConverter" />
    </UserControl.Resources>

    <Design.DataContext>
        <dt:GroupViewModel />
    </Design.DataContext>

    <TabControl
        Margin="{DynamicResource ContentMargin}"
        ItemsSource="{Binding Tabs}"
        SelectedItem="{Binding Selected}">

        <TabControl.ItemTemplate>
            <DataTemplate>

                <Grid
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="{StaticResource ColorBackground}">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="{Binding HasKey, Converter={StaticResource BoolToGridSizeAutoConverter}}" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        Margin="{StaticResource TabMargin}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        FontSize="{DynamicResource FontSizeContent}"
                        Text="{Binding Name}" />

                    <Viewbox
                        Grid.Column="1"
                        Margin="{StaticResource KeyMargin}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        IsVisible="{Binding HasKey}"
                        Stretch="Uniform"
                        StretchDirection="DownOnly">
                        <Border
                            Padding="{StaticResource KeyPadding}"
                            Background="{StaticResource KeyBackgroundColor}"
                            BorderBrush="{StaticResource KeyBorderColor}"
                            BorderThickness="{StaticResource KeyBorderThickness}"
                            CornerRadius="{StaticResource KeyCornerRadius}">

                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="{StaticResource FontSizeContent}"
                                FontWeight="Bold"
                                Text="{Binding Key}" />
                        </Border>
                    </Viewbox>
                </Grid>
            </DataTemplate>
        </TabControl.ItemTemplate>

        <TabControl.ContentTemplate>
            <DataTemplate>

                <v:GridView />
            </DataTemplate>
        </TabControl.ContentTemplate>
    </TabControl>
</UserControl>