<UserControl
    x:Class="SportDJ.Modules.GridModule.Views.GroupView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:coc="using:SportDJ.Commons.Converters"
    xmlns:com="using:SportDJ.Modules.GridModule.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dt="using:SportDJ.Modules.GridModule.DesignTime"
    xmlns:gbac="using:GroupBox.Avalonia.Controls"
    xmlns:gbact="using:GroupBox.Avalonia.ControlThemes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:v="using:SportDJ.Modules.GridModule.Views"
    xmlns:vm="using:SportDJ.Modules.GridModule.ViewModels"
    d:DesignHeight="300"
    d:DesignWidth="300"
    prism:ViewModelLocator.AutoWireViewModel="False"
    mc:Ignorable="d">

    <UserControl.Resources>

        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Commons/Assets/Ressources.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>

        <Thickness x:Key="InnerMargin">1</Thickness>
        <Thickness x:Key="TabMargin">20,5,20,5</Thickness>

        <coc:BoolToGridSizeAutoConverter x:Key="BoolToGridSizeAutoConverter" />
        <coc:BoolToGridSizeStarConverter x:Key="BoolToGridSizeStarConverter" />
        <com:KeyCodeToStringConverter x:Key="KeyCodeToStringConverter" />
    </UserControl.Resources>

    <Design.DataContext>
        <dt:GroupViewModel />
    </Design.DataContext>

    <TabControl
        Margin="{DynamicResource ContentMargin}"
        ItemsSource="{Binding Tabs}"
        SelectedItem="{Binding Tab}">

        <TabControl.ItemTemplate>
            <DataTemplate>

                <Grid
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="{StaticResource ColorBackground}">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="{Binding HasKey, Converter={StaticResource BoolToGridSizeStarConverter}}" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        Margin="{StaticResource TabMargin}"
                        Padding="2"
                        FontSize="{DynamicResource FontSizeContent}"
                        Text="{Binding Name}" />

                    <Border
                        Grid.Column="2"
                        Margin="{StaticResource TabMargin}"
                        Padding="15,0,15,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{StaticResource ColorKey}"
                        BorderBrush="LightGray"
                        BorderThickness="1"
                        CornerRadius="{StaticResource CornerRadius}"
                        IsVisible="{Binding HasKey}">

                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="{StaticResource FontSizeContent}"
                            FontWeight="Bold"
                            Text="{Binding Key, Converter={StaticResource KeyCodeToStringConverter}}" />
                    </Border>
                </Grid>
            </DataTemplate>
        </TabControl.ItemTemplate>

        <TabControl.ContentTemplate>
            <DataTemplate>

                <v:GridView />
            </DataTemplate>
        </TabControl.ContentTemplate>
    </TabControl>
</UserControl>