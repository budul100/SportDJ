<UserControl
    x:Class="SportDJ.Modules.GridModule.Views.GroupView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ct="using:SportDJ.Shareds.UserControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dt="using:SportDJ.Modules.GridModule.DesignTime"
    xmlns:gbac="using:GroupBox.Avalonia.Controls"
    xmlns:gbact="using:GroupBox.Avalonia.ControlThemes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:v="using:SportDJ.Modules.GridModule.Views"
    xmlns:vm="using:SportDJ.Modules.GridModule.ViewModels"
    d:DesignHeight="300"
    d:DesignWidth="500"
    prism:ViewModelLocator.AutoWireViewModel="False"
    x:DataType="dt:GroupViewModel"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Commons/Assets/Ressources.axaml" />
            </ResourceDictionary.MergedDictionaries>
            
            <Thickness x:Key="InnerMargin">1</Thickness>
        </ResourceDictionary>
    </UserControl.Resources>

    <Design.DataContext>
        <dt:GroupViewModel />
    </Design.DataContext>

    <TabControl
        Margin="{StaticResource ContentMargin}"
        Focusable="False"
        ItemsSource="{Binding Tabs}"
        SelectedItem="{Binding Selected}">

        <TabControl.ItemTemplate>
            <DataTemplate>

                <Grid
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="{StaticResource ColorBackground}"
                    Focusable="False">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="{Binding HasKey, Converter={StaticResource BoolToGridSizeAutoConverter}}" />
                    </Grid.ColumnDefinitions>

                    <Grid.ContextMenu>
                        <ContextMenu ItemsSource="{Binding Menus}" Opened="OnContextMenuOpened">

                            <ContextMenu.DataTemplates>
                                <DataTemplate x:DataType="vm:MenuViewModel">
                                    <v:MenuView />
                                </DataTemplate>
                                <DataTemplate x:DataType="vm:SeparatorViewModel">
                                    <Separator />
                                </DataTemplate>
                            </ContextMenu.DataTemplates>
                        </ContextMenu>
                    </Grid.ContextMenu>

                    <Viewbox
                        Grid.Column="0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Focusable="False"
                        Stretch="Uniform"
                        StretchDirection="DownOnly">

                        <ct:EditableText
                            Margin="{StaticResource GroupTabMargin}"
                            FontSize="{StaticResource FontSizeContentSub}"
                            FontStyle="Italic"
                            IsActive="{Binding IsRenaming}"
                            MaxLength="{Binding MaxLengthName}"
                            Text="{Binding Name}" />
                    </Viewbox>

                    <Viewbox
                        Grid.Column="1"
                        Margin="{StaticResource KeyMargin}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Focusable="False"
                        IsVisible="{Binding HasKey}"
                        Stretch="Uniform"
                        StretchDirection="DownOnly">

                        <Border
                            Padding="{StaticResource KeyPadding}"
                            Background="{StaticResource KeyBackgroundColor}"
                            BorderBrush="{StaticResource KeyBorderColor}"
                            BorderThickness="{StaticResource KeyBorderThickness}"
                            CornerRadius="{StaticResource KeyCornerRadius}">

                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="{StaticResource FontSizeState}"
                                Text="{Binding Key}" />
                        </Border>
                    </Viewbox>
                </Grid>
            </DataTemplate>
        </TabControl.ItemTemplate>

        <TabControl.ContentTemplate>
            <DataTemplate>
                <v:GridView />
            </DataTemplate>
        </TabControl.ContentTemplate>
    </TabControl>
</UserControl>