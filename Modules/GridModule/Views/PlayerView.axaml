<UserControl
    x:Class="SportDJ.Modules.GridModule.Views.PlayerView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:assets="using:SportDJ.Commons.Assets"
    xmlns:ct="using:SportDJ.Shareds.UserControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dt="using:SportDJ.Modules.GridModule.DesignTime"
    xmlns:mat="using:Material.Icons.Avalonia"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:v="using:SportDJ.Modules.GridModule.Views"
    xmlns:vm="using:SportDJ.Modules.GridModule.ViewModels"
    d:DesignHeight="150"
    d:DesignWidth="150"
    x:DataType="vm:PlayerViewModel"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Commons/Assets/Ressources.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.Styles>
        <mat:MaterialIconStyles />

        <!--
            The player color is the idle background. It is set as style (not as local value),
            so the playing state can still override it. Playing is repeated after the color,
            because the last matching style wins.
        -->
        <Style Selector="Border.PlayerSurface" x:DataType="vm:PlayerViewModel">
            <Setter Property="Background" Value="{Binding SurfaceBrush}" />
        </Style>
        <Style Selector="Border.PlayerSurface.IsPlaying">
            <Setter Property="Background" Value="{StaticResource ColorIsPlaying}" />
        </Style>
    </UserControl.Styles>

    <Design.DataContext>
        <dt:PlayerViewModel />
    </Design.DataContext>

    <!-- The looks of PlayerCard and PlayerSurface (radii, states, transitions) are defined in Styles.axaml -->
    <Border
        Name="PlayingBorder"
        Margin="{StaticResource ContentMargin}"
        Classes="PlayerCard"
        Classes.IsActive="{Binding IsActive}">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="4*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--
                Top row: PFL, key, settings.
                The gaps are Auto columns with a 4 px wide Border, which is only visible together with its neighbour.
                Fixed 4 px columns would also keep their width if the neighbour is hidden and push the buttons inwards.
            -->
            <Grid Grid.Row="0" Margin="{StaticResource InnerMargin}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding HasPFL, Converter={StaticResource BoolToGridSizeStarConverter}}" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="{Binding HasKey, Converter={StaticResource BoolToGridSizeStarConverter}}" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ToggleButton
                    Grid.Column="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Focusable="False"
                    IsVisible="{Binding HasPFL}">

                    <Viewbox
                        MaxWidth="{StaticResource LargeIconSize}"
                        MaxHeight="{StaticResource LargeIconSize}"
                        Stretch="Uniform"
                        StretchDirection="Both">
                        <mat:MaterialIcon
                            Width="{StaticResource PlayerIconSize}"
                            Height="{StaticResource PlayerIconSize}"
                            Kind="Headphones" />
                    </Viewbox>

                </ToggleButton>

                <!-- Gap after PFL -->
                <Border
                    Grid.Column="1"
                    Width="{StaticResource SpacingSmall}"
                    IsVisible="{Binding HasPFL}" />

                <Border
                    Grid.Column="2"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Classes="KeyBadge"
                    IsVisible="{Binding HasKey}">

                    <Viewbox
                        MaxWidth="{StaticResource LargeIconSize}"
                        MaxHeight="{StaticResource LargeIconSize}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Stretch="Uniform"
                        StretchDirection="Both">

                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="{StaticResource FontSizeContentMain}"
                            Text="{Binding Key}" />
                    </Viewbox>

                </Border>

                <!-- Gap after key -->
                <Border
                    Grid.Column="3"
                    Width="{StaticResource SpacingSmall}"
                    IsVisible="{Binding HasKey}" />

                <ToggleButton
                    Grid.Column="4"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Focusable="False"
                    IsChecked="{Binding IsSettingsVisible, Mode=OneWay}"
                    Command="{Binding ShowSettingsCommand}">

                    <Viewbox
                        MaxWidth="{StaticResource LargeIconSize}"
                        MaxHeight="{StaticResource LargeIconSize}"
                        Stretch="Uniform"
                        StretchDirection="Both">
                        <mat:MaterialIcon
                            Width="{StaticResource PlayerIconSize}"
                            Height="{StaticResource PlayerIconSize}"
                            Kind="Build" />
                    </Viewbox>

                </ToggleButton>
            </Grid>

            <!-- Main surface -->
            <Border
                Grid.Row="1"
                Margin="{StaticResource InnerMargin}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Classes="PlayerSurface"
                Classes.IsPlaying="{Binding IsPlaying}">

                <Button
                    Name="ExecuteButton"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="Transparent"
                    Command="{Binding ExecuteCommand}"
                    Focusable="False">

                    <Button.ContextMenu>
                        <ContextMenu
                            Closed="OnContextMenuClosed"
                            ItemsSource="{Binding Menus}"
                            Opened="OnContextMenuOpened">

                            <ContextMenu.DataTemplates>
                                <DataTemplate x:DataType="vm:MenuViewModel">
                                    <v:MenuView />
                                </DataTemplate>
                                <DataTemplate x:DataType="vm:SeparatorViewModel">
                                    <Separator />
                                </DataTemplate>
                            </ContextMenu.DataTemplates>
                        </ContextMenu>
                    </Button.ContextMenu>

                    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>

                            <Viewbox
                                Grid.Column="0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Focusable="False"
                                Stretch="Uniform"
                                StretchDirection="DownOnly">
                                <TextBlock
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Focusable="False"
                                    FontSize="{StaticResource FontSizeState}"
                                    Text="{Binding Counter}" />
                            </Viewbox>

                            <Viewbox
                                Grid.Column="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Stretch="Uniform"
                                StretchDirection="DownOnly">
                                <ct:EditableText
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Top"
                                    FontSize="{StaticResource FontSizeState}"
                                    FontWeight="{StaticResource FontWeightTitle}"
                                    IsActive="{Binding IsRenaming}"
                                    MaxLength="{x:Static assets:Constants.NameMaxLength}"
                                    Text="{Binding Name}" />
                            </Viewbox>

                            <Viewbox
                                Grid.Column="2"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Stretch="Uniform"
                                StretchDirection="DownOnly">
                                <StackPanel
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Orientation="Horizontal"
                                    Spacing="2">
                                    <mat:MaterialIcon
                                        Width="{StaticResource FontSizeState}"
                                        Height="{StaticResource FontSizeState}"
                                        VerticalAlignment="Center"
                                        IsVisible="{Binding IsOverlay}"
                                        Kind="ChevronUpBoxOutline" />
                                    <TextBlock
                                        Focusable="False"
                                        FontSize="{StaticResource FontSizeState}"
                                        FontWeight="{StaticResource FontWeightLabel}"
                                        Text="{Binding Remaining}" />
                                </StackPanel>
                            </Viewbox>
                        </Grid>

                        <Viewbox
                            Grid.Row="1"
                            Stretch="Uniform"
                            StretchDirection="DownOnly">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Focusable="False"
                                FontSize="{StaticResource FontSizeContentMain}"
                                Text="{Binding Info}" />
                        </Viewbox>

                        <ct:WaveRenderer
                            Grid.Row="2"
                            Bitmap="{Binding Bitmap}"
                            VerticalAlignment="Stretch"
                            HorizontalAlignment="Stretch"
                            Focusable="False"
                            OpacityPlayed="{StaticResource TrackOpacityPlayed}"
                            Progress="{Binding Progress}" />
                    </Grid>
                </Button>
            </Border>

            <!--
                Bottom row: previous, stack, next.
                Same principle as in the top row: the gaps only take space together with the outer buttons.
            -->
            <Grid Grid.Row="2" Margin="{StaticResource InnerMargin}">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding HasStack, Converter={StaticResource BoolToGridSizeStarConverter}}" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="{Binding HasStack, Converter={StaticResource BoolToGridSizeStarConverter}}" />
                </Grid.ColumnDefinitions>

                <Button
                    Grid.Column="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{Binding TrackBackwardCommand}"
                    Focusable="False"
                    IsVisible="{Binding HasStack}">

                    <Viewbox
                        MaxWidth="{StaticResource LargeIconSize}"
                        MaxHeight="{StaticResource LargeIconSize}"
                        Stretch="Uniform"
                        StretchDirection="Both">
                        <mat:MaterialIcon
                            Width="{StaticResource PlayerIconSize}"
                            Height="{StaticResource PlayerIconSize}"
                            Kind="SkipBackward" />
                    </Viewbox>

                </Button>

                <Border
                    Grid.Column="1"
                    Width="{StaticResource SpacingSmall}"
                    IsVisible="{Binding HasStack}" />

                <ToggleButton
                    Grid.Column="2"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    IsChecked="{Binding IsStackVisible, Mode=OneWay}"
                    Command="{Binding ShowStackCommand}"
                    Focusable="False">

                    <Viewbox
                        MaxWidth="{StaticResource LargeIconSize}"
                        MaxHeight="{StaticResource LargeIconSize}"
                        Stretch="Uniform"
                        StretchDirection="Both">
                        <mat:MaterialIcon
                            Width="{StaticResource PlayerIconSize}"
                            Height="{StaticResource PlayerIconSize}"
                            Kind="ListBox" />
                    </Viewbox>

                </ToggleButton>

                <Border
                    Grid.Column="3"
                    Width="{StaticResource SpacingSmall}"
                    IsVisible="{Binding HasStack}" />

                <Button
                    Grid.Column="4"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{Binding TrackForwardCommand}"
                    Focusable="False"
                    IsVisible="{Binding HasStack}">

                    <Viewbox
                        MaxWidth="{StaticResource LargeIconSize}"
                        MaxHeight="{StaticResource LargeIconSize}"
                        Stretch="Uniform"
                        StretchDirection="Both">
                        <mat:MaterialIcon
                            Width="{StaticResource PlayerIconSize}"
                            Height="{StaticResource PlayerIconSize}"
                            Kind="SkipForward" />
                    </Viewbox>

                </Button>

            </Grid>
        </Grid>
    </Border>
</UserControl>
