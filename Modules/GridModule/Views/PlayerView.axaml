<UserControl
    x:Class="SportDJ.Modules.GridModule.Views.PlayerView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:a="clr-namespace:Avalonia.Xaml.Interactions.Core;assembly=Avalonia.Xaml.Interactions"
    xmlns:coc="using:SportDJ.Commons.Converters"
    xmlns:com="using:SportDJ.Modules.GridModule.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dt="using:SportDJ.Modules.GridModule.DesignTime"
    xmlns:i="clr-namespace:Avalonia.Xaml.Interactivity;assembly=Avalonia.Xaml.Interactivity"
    xmlns:mat="using:Material.Icons.Avalonia"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    d:DesignHeight="150"
    d:DesignWidth="150"
    prism:ViewModelLocator.AutoWireViewModel="False"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Commons/Assets/Ressources.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>

        <Thickness x:Key="InnerMargin">1</Thickness>

        <x:Double x:Key="StateFontSize">15</x:Double>

        <x:Double x:Key="IconWidth">30</x:Double>
        <x:Double x:Key="IconHeight">30</x:Double>

        <coc:BoolToGridSizeConverter x:Key="BoolToGridSizeConverter" />
        <com:KeyCodeToStringConverter x:Key="KeyCodeToStringConverter" />
    </UserControl.Resources>

    <UserControl.Styles>
        <mat:MaterialIconStyles />
    </UserControl.Styles>

    <Design.DataContext>
        <dt:PlayerViewModel />
    </Design.DataContext>

    <Border
        Name="PlayingBorder"
        Margin="{StaticResource ContentMargin}"
        BorderBrush="Purple">

        <i:Interaction.Behaviors>
            <a:DataTriggerBehavior
                Binding="{Binding IsPlaying}"
                ComparisonCondition="Equal"
                Value="True">
                <a:ChangePropertyAction
                    PropertyName="BorderThickness"
                    TargetObject="PlayingBorder"
                    Value="{StaticResource BorderPlaying}" />
            </a:DataTriggerBehavior>
            <a:DataTriggerBehavior
                Binding="{Binding IsPlaying}"
                ComparisonCondition="NotEqual"
                Value="True">
                <a:ChangePropertyAction
                    PropertyName="BorderThickness"
                    TargetObject="PlayingBorder"
                    Value="{StaticResource BorderPlayingNot}" />
            </a:DataTriggerBehavior>
        </i:Interaction.Behaviors>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="1*" />
                <RowDefinition Height="4*" />
                <RowDefinition Height="{Binding HasStack, Converter={StaticResource BoolToGridSizeConverter}}" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="{Binding HasKey, Converter={StaticResource BoolToGridSizeConverter}}" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="{StaticResource InnerMargin}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch">
                    <mat:MaterialIcon
                        Width="{StaticResource IconWidth}"
                        Height="{StaticResource IconHeight}"
                        Kind="Headphones" />
                </Button>

                <Border
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="{StaticResource InnerMargin}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="{StaticResource Background}"
                    CornerRadius="{StaticResource CornerRadius}"
                    IsVisible="{Binding HasKey}">

                    <Border
                        Width="{Binding $self.Bounds.Height}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{StaticResource BackgroundKey}"
                        BorderBrush="LightGray"
                        BorderThickness="1"
                        CornerRadius="{StaticResource CornerRadius}">

                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="{StaticResource ContentFontSize}"
                            FontWeight="Bold"
                            Text="{Binding Key, Converter={StaticResource KeyCodeToStringConverter}}" />
                    </Border>
                </Border>

                <Button
                    Grid.Row="0"
                    Grid.Column="2"
                    Margin="{StaticResource InnerMargin}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch" />
            </Grid>

            <Border
                Name="ExecutionBorder"
                Grid.Row="1"
                Grid.Column="0"
                Margin="{StaticResource InnerMargin}">

                <i:Interaction.Behaviors>
                    <a:DataTriggerBehavior
                        Binding="{Binding IsActive}"
                        ComparisonCondition="Equal"
                        Value="True">
                        <a:ChangePropertyAction
                            PropertyName="Background"
                            TargetObject="ExecutionBorder"
                            Value="{StaticResource BackgroundPlaying}" />
                    </a:DataTriggerBehavior>
                    <a:DataTriggerBehavior
                        Binding="{Binding IsActive}"
                        ComparisonCondition="NotEqual"
                        Value="True">
                        <a:ChangePropertyAction
                            PropertyName="Background"
                            TargetObject="ExecutionBorder"
                            Value="Transparent" />
                    </a:DataTriggerBehavior>
                </i:Interaction.Behaviors>

                <Button
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{Binding ExecuteCommand}">

                    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="{StaticResource ContentFontSize}"
                            FontWeight="Bold"
                            Text="{Binding Name}" />

                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="{StaticResource ContentFontSize}"
                            Text="{Binding Content}" />

                        <Grid Grid.Row="2" Grid.Column="0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                FontSize="{StaticResource StateFontSize}"
                                Text="{Binding Remaining}" />

                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontSize="{StaticResource StateFontSize}"
                                Text="{Binding Counter}" />
                        </Grid>

                        <Image
                            Grid.Row="3"
                            Grid.Column="0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Source="{Binding Bitmap}"
                            Stretch="Fill" />
                    </Grid>
                </Button>
            </Border>

            <Grid Grid.Row="2" IsVisible="{Binding HasStack}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="{StaticResource InnerMargin}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{Binding TrackBackwardCommand}">
                    <mat:MaterialIcon
                        Width="{StaticResource IconWidth}"
                        Height="{StaticResource IconHeight}"
                        Kind="SkipBackward" />
                </Button>

                <Button
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="{StaticResource InnerMargin}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{Binding TrackForwardCommand}">
                    <mat:MaterialIcon
                        Width="{StaticResource IconWidth}"
                        Height="{StaticResource IconHeight}"
                        Kind="SkipForward" />
                </Button>
            </Grid>
        </Grid>
    </Border>
</UserControl>