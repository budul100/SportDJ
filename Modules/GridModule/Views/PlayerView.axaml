<UserControl
    x:Class="SportDJ.Modules.GridModule.Views.PlayerView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:a="clr-namespace:Avalonia.Xaml.Interactions.Core;assembly=Avalonia.Xaml.Interactions"
    xmlns:coc="using:SportDJ.Commons.Converters"
    xmlns:com="using:SportDJ.Modules.GridModule.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dt="using:SportDJ.Modules.GridModule.DesignTime"
    xmlns:i="clr-namespace:Avalonia.Xaml.Interactivity;assembly=Avalonia.Xaml.Interactivity"
    xmlns:mat="using:Material.Icons.Avalonia"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:v="using:SportDJ.Modules.GridModule.Views"
    xmlns:vm="using:SportDJ.Modules.GridModule.ViewModels"
    d:DesignHeight="150"
    d:DesignWidth="150"
    prism:ViewModelLocator.AutoWireViewModel="False"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Commons/Assets/Ressources.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>

        <Thickness x:Key="InnerMargin">1</Thickness>
        <x:Double x:Key="IconWidth">30</x:Double>
        <x:Double x:Key="IconHeight">30</x:Double>

        <coc:BoolToGridSizeAutoConverter x:Key="BoolToGridSizeAutoConverter" />
        <coc:BoolToGridSizeStarConverter x:Key="BoolToGridSizeStarConverter" />
        <com:KeyCodeToStringConverter x:Key="KeyCodeToStringConverter" />

    </UserControl.Resources>

    <UserControl.Styles>
        <mat:MaterialIconStyles />
    </UserControl.Styles>

    <Design.DataContext>
        <dt:PlayerViewModel />
    </Design.DataContext>

    <Border
        Name="PlayingBorder"
        Margin="{StaticResource ContentMargin}"
        BorderBrush="{StaticResource ColorPlaying}"
        CornerRadius="4">

        <i:Interaction.Behaviors>
            <a:DataTriggerBehavior
                Binding="{Binding IsPlaying}"
                ComparisonCondition="Equal"
                Value="True">
                <a:ChangePropertyAction
                    PropertyName="BorderThickness"
                    TargetObject="PlayingBorder"
                    Value="{StaticResource ThicknessPlaying}" />
            </a:DataTriggerBehavior>
            <a:DataTriggerBehavior
                Binding="{Binding IsPlaying}"
                ComparisonCondition="Equal"
                Value="False">
                <a:ChangePropertyAction
                    PropertyName="BorderThickness"
                    TargetObject="PlayingBorder"
                    Value="{StaticResource ThicknessPlayingNot}" />
            </a:DataTriggerBehavior>
        </i:Interaction.Behaviors>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="40" />
                <RowDefinition Height="5*" />
                <RowDefinition Height="{Binding HasStack, Converter={StaticResource BoolToGridSizeStarConverter}}" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="{Binding HasKey, Converter={StaticResource BoolToGridSizeStarConverter}}" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="{StaticResource InnerMargin}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch">
                    <mat:MaterialIcon
                        Width="{StaticResource IconWidth}"
                        Height="{StaticResource IconHeight}"
                        Kind="Headphones" />
                </Button>

                <Panel
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="{StaticResource InnerMargin}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="{StaticResource ColorBackground}">

                    <Border
                        Padding="15,0,15,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{StaticResource ColorKey}"
                        BorderBrush="LightGray"
                        BorderThickness="1"
                        CornerRadius="{StaticResource CornerRadius}"
                        IsVisible="{Binding HasKey}">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="{StaticResource FontSizeContent}"
                            FontWeight="Bold"
                            Text="{Binding Key, Converter={StaticResource KeyCodeToStringConverter}}" />
                    </Border>

                </Panel>

                <Button
                    Grid.Row="0"
                    Grid.Column="2"
                    Margin="{StaticResource InnerMargin}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch">
                    <mat:MaterialIcon
                        Width="{StaticResource IconWidth}"
                        Height="{StaticResource IconHeight}"
                        Kind="Restore" />
                </Button>
            </Grid>

            <Border
                Grid.Row="1"
                Margin="{StaticResource InnerMargin}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                CornerRadius="{StaticResource ButtonRadius}">

                <i:Interaction.Behaviors>
                    <a:DataTriggerBehavior
                        Binding="{Binding IsActive}"
                        ComparisonCondition="Equal"
                        Value="True">
                        <a:ChangePropertyAction PropertyName="Background" Value="{StaticResource ColorPlaying}" />
                    </a:DataTriggerBehavior>
                    <a:DataTriggerBehavior
                        Binding="{Binding IsActive}"
                        ComparisonCondition="NotEqual"
                        Value="True">
                        <a:ChangePropertyAction PropertyName="Background" Value="{StaticResource ColorBackground}" />
                    </a:DataTriggerBehavior>
                </i:Interaction.Behaviors>

                <Button
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="Transparent"
                    Command="{Binding ExecuteCommand}">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Grid.Column="0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                FontSize="{StaticResource FontSizeState}"
                                Text="{Binding Counter}" />

                            <TextBlock
                                Grid.Column="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                FontSize="{StaticResource FontSizeContent}"
                                FontWeight="Bold"
                                Text="{Binding Name}" />

                            <TextBlock
                                Grid.Column="2"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                FontSize="{StaticResource FontSizeState}"
                                Text="{Binding Remaining}" />
                        </Grid>

                        <TextBlock
                            Grid.Row="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="{StaticResource FontSizeContent}"
                            Text="{Binding Content}" />

                        <Image
                            Grid.Row="2"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Source="{Binding Bitmap}"
                            Stretch="Fill" />
                    </Grid>

                    <Button.ContextMenu>
                        <ContextMenu Name="ContextMenu" ItemsSource="{Binding Menus}">

                            <ContextMenu.ItemTemplate>
                                <DataTemplate>
                                    <v:MenuView />
                                </DataTemplate>
                            </ContextMenu.ItemTemplate>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </Border>

            <Grid Grid.Row="2" IsVisible="{Binding HasStack}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="{StaticResource InnerMargin}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{Binding TrackBackwardCommand}">
                    <mat:MaterialIcon
                        Width="{StaticResource IconWidth}"
                        Height="{StaticResource IconHeight}"
                        Kind="SkipBackward" />
                </Button>

                <Button
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="{StaticResource InnerMargin}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{Binding TrackForwardCommand}">
                    <mat:MaterialIcon
                        Width="{StaticResource IconWidth}"
                        Height="{StaticResource IconHeight}"
                        Kind="SkipForward" />
                </Button>
            </Grid>
        </Grid>
    </Border>
</UserControl>