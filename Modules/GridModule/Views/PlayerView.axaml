<UserControl
    x:Class="SportDJ.Modules.GridModule.Views.PlayerView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:a="clr-namespace:Avalonia.Xaml.Interactions.Core;assembly=Avalonia.Xaml.Interactions"
    xmlns:ct="using:SportDJ.Commons.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dt="using:SportDJ.Modules.GridModule.DesignTime"
    xmlns:i="clr-namespace:Avalonia.Xaml.Interactivity;assembly=Avalonia.Xaml.Interactivity"
    xmlns:mat="using:Material.Icons.Avalonia"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:v="using:SportDJ.Modules.GridModule.Views"
    xmlns:vm="using:SportDJ.Modules.GridModule.ViewModels"
    d:DesignHeight="150"
    d:DesignWidth="150"
    prism:ViewModelLocator.AutoWireViewModel="False"
    x:DataType="dt:PlayerViewModel"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Commons/Assets/Ressources.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>

        <Thickness x:Key="InnerMargin">1</Thickness>
    </UserControl.Resources>

    <UserControl.Styles>
        <mat:MaterialIconStyles />
    </UserControl.Styles>

    <Design.DataContext>
        <dt:PlayerViewModel />
    </Design.DataContext>

    <Border
        Name="PlayingBorder"
        Margin="{StaticResource ContentMargin}"
        BorderThickness="{StaticResource PlayerBorderThickness}"
        Classes.IsActive="{Binding IsActive}"
        CornerRadius="{StaticResource PlayerCornerRadius}">

        <Border.Styles>
            <Style Selector="Border.IsActive">
                <Setter Property="BorderBrush" Value="{StaticResource ColorIsPlaying}" />
            </Style>
            <Style Selector="Border">
                <Setter Property="BorderBrush" Value="Transparent" />
            </Style>
        </Border.Styles>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="4*" />
                <RowDefinition Height="{Binding HasStack, Converter={StaticResource BoolToGridSizeStarConverter}}" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="{StaticResource InnerMargin}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding HasPFL, Converter={StaticResource BoolToGridSizeStarConverter}}" />
                    <ColumnDefinition Width="2" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="2" />
                    <ColumnDefinition Width="{Binding HasKey, Converter={StaticResource BoolToGridSizeStarConverter}}" />
                </Grid.ColumnDefinitions>

                <ToggleButton
                    Grid.Column="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Focusable="False">
                    <Viewbox
                        MaxWidth="{StaticResource LargeIconSize}"
                        MaxHeight="{StaticResource LargeIconSize}"
                        Stretch="Uniform"
                        StretchDirection="Both">
                        <mat:MaterialIcon
                            Width="{StaticResource PlayerIconSize}"
                            Height="{StaticResource PlayerIconSize}"
                            Kind="Headphones" />
                    </Viewbox>
                </ToggleButton>

                <ToggleButton
                    Grid.Column="2"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Focusable="False"
                    IsChecked="{Binding IsLoop}"
                    IsEnabled="{Binding IsAvailableExecute}">
                    <Viewbox
                        MaxWidth="{StaticResource LargeIconSize}"
                        MaxHeight="{StaticResource LargeIconSize}"
                        Stretch="Uniform"
                        StretchDirection="Both">
                        <mat:MaterialIcon
                            Width="{StaticResource PlayerIconSize}"
                            Height="{StaticResource PlayerIconSize}"
                            Kind="Repeat" />
                    </Viewbox>
                </ToggleButton>

                <Panel
                    Grid.Column="4"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="{StaticResource ColorBackground}">

                    <Viewbox
                        MaxWidth="{StaticResource LargeIconSize}"
                        MaxHeight="{StaticResource LargeIconSize}"
                        Margin="{StaticResource KeyMargin}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsVisible="{Binding HasKey}"
                        Stretch="Uniform"
                        StretchDirection="Both">

                        <Button
                            Padding="{StaticResource KeyPadding}"
                            Background="{StaticResource KeyBackgroundColor}"
                            BorderBrush="{StaticResource KeyBorderColor}"
                            BorderThickness="{StaticResource KeyBorderThickness}"
                            CornerRadius="{StaticResource KeyCornerRadius}">

                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="{StaticResource FontSizeContentMain}"
                                Text="{Binding Key}" />
                        </Button>
                    </Viewbox>
                </Panel>
            </Grid>

            <Border
                Grid.Row="1"
                Margin="{StaticResource InnerMargin}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Classes.IsForeground="{Binding IsForeground}"
                Classes.IsPlaying="{Binding IsPlaying}">

                <Border.Styles>
                    <Style Selector="Border.IsForeground">
                        <Setter Property="Background" Value="{StaticResource ColorIsForeground}" />
                    </Style>
                    <Style Selector="Border.IsPlaying">
                        <Setter Property="Background" Value="{StaticResource ColorIsPlaying}" />
                    </Style>
                    <Style Selector="Border">
                        <Setter Property="Background" Value="{StaticResource ColorBackground}" />
                    </Style>
                </Border.Styles>

                <Button
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="Transparent"
                    Command="{Binding ExecuteCommand}"
                    Focusable="False">

                    <Button.ContextMenu>
                        <ContextMenu
                            Name="ContextMenu"
                            IsVisible="{Binding IsAvailableMenu}"
                            ItemsSource="{Binding Menus}"
                            Opened="OnContextMenuOpened">

                            <ContextMenu.DataTemplates>
                                <DataTemplate x:DataType="vm:MenuViewModel">
                                    <v:MenuView />
                                </DataTemplate>
                                <DataTemplate x:DataType="vm:SeparatorViewModel">
                                    <Separator />
                                </DataTemplate>
                            </ContextMenu.DataTemplates>
                        </ContextMenu>
                    </Button.ContextMenu>

                    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>

                            <Viewbox
                                Grid.Column="0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Stretch="Uniform"
                                StretchDirection="DownOnly">
                                <TextBlock
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    FontSize="{StaticResource FontSizeState}"
                                    Text="{Binding Counter}" />
                            </Viewbox>

                            <Viewbox
                                Grid.Column="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Stretch="Uniform"
                                StretchDirection="DownOnly">
                                <ct:EditableText
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Top"
                                    FontSize="{StaticResource FontSizeState}"
                                    FontStyle="Italic"
                                    IsActive="{Binding IsRenaming}"
                                    MaxLength="{Binding MaxLengthName}"
                                    Text="{Binding Name}" />
                            </Viewbox>

                            <Viewbox
                                Grid.Column="2"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Stretch="Uniform"
                                StretchDirection="DownOnly">
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    FontSize="{StaticResource FontSizeState}"
                                    Text="{Binding Remaining}" />
                            </Viewbox>
                        </Grid>

                        <Viewbox
                            Grid.Row="1"
                            Stretch="Uniform"
                            StretchDirection="DownOnly">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="{StaticResource FontSizeContentMain}"
                                Text="{Binding Content}" />
                        </Viewbox>

                        <ct:TrackRenderer
                            Grid.Row="2"
                            Bitmap="{Binding Bitmap}"
                            OpacityPlayed="{StaticResource TrackOpacityPlayed}"
                            Progress="{Binding Progress}" />
                    </Grid>
                </Button>
            </Border>

            <Grid Grid.Row="2" Margin="{StaticResource InnerMargin}">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="2" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="2" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button
                    Grid.Column="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{Binding TrackBackwardCommand}"
                    Focusable="False">
                    <Viewbox
                        MaxWidth="{StaticResource LargeIconSize}"
                        MaxHeight="{StaticResource LargeIconSize}"
                        Stretch="Uniform"
                        StretchDirection="Both">
                        <mat:MaterialIcon
                            Width="{StaticResource PlayerIconSize}"
                            Height="{StaticResource PlayerIconSize}"
                            Kind="SkipBackward" />
                    </Viewbox>
                </Button>

                <Button
                    Grid.Column="2"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{Binding ResetCommand}"
                    Focusable="False">
                    <Viewbox
                        MaxWidth="{StaticResource LargeIconSize}"
                        MaxHeight="{StaticResource LargeIconSize}"
                        Stretch="Uniform"
                        StretchDirection="Both">
                        <mat:MaterialIcon
                            Width="{StaticResource PlayerIconSize}"
                            Height="{StaticResource PlayerIconSize}"
                            Kind="History" />
                    </Viewbox>
                </Button>

                <Button
                    Grid.Column="4"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{Binding TrackForwardCommand}"
                    Focusable="False">
                    <Viewbox
                        MaxWidth="{StaticResource LargeIconSize}"
                        MaxHeight="{StaticResource LargeIconSize}"
                        Stretch="Uniform"
                        StretchDirection="Both">
                        <mat:MaterialIcon
                            Width="{StaticResource PlayerIconSize}"
                            Height="{StaticResource PlayerIconSize}"
                            Kind="SkipForward" />
                    </Viewbox>
                </Button>
            </Grid>
        </Grid>
    </Border>
</UserControl>