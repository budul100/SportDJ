<UserControl
    x:Class="SportDJ.Modules.GridModule.Views.MenuView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:a="clr-namespace:Avalonia.Xaml.Interactions.Core;assembly=Avalonia.Xaml.Interactions"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="clr-namespace:Avalonia.Xaml.Interactivity;assembly=Avalonia.Xaml.Interactivity"
    xmlns:mat="using:Material.Icons.Avalonia"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:v="using:SportDJ.Modules.GridModule.Views"
    xmlns:vm="using:SportDJ.Modules.GridModule.ViewModels"
    d:DesignHeight="150"
    d:DesignWidth="150"
    prism:ViewModelLocator.AutoWireViewModel="False"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Commons/Assets/Ressources.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.Styles>
        <mat:MaterialIconStyles />
    </UserControl.Styles>

    <MenuItem
        Name="MenuItem"
        AutoScrollToSelectedItem="True"
        Classes.IsChecked="{Binding IsChecked}"
        Command="{Binding Command}"
        FontStyle="{Binding IsPlayed, Converter={StaticResource BoolToFontStyleConverter}, ConverterParameter={StaticResource TrackFontStylePlayed}}"
        FontWeight="{Binding IsSelected, Converter={StaticResource BoolToFontWeightConverter}, ConverterParameter={StaticResource TrackFontWeightSelected}}"
        Header="{Binding Header}"
        ItemsSource="{Binding MenuItems}"
        SelectedItem="{Binding Selected}"
        StaysOpenOnClick="False">

        <MenuItem.Styles>
            <Style Selector="MenuItem.IsChecked">
                <Setter Property="Background" Value="{StaticResource ColorIsChecked}" />
            </Style>
        </MenuItem.Styles>

        <MenuItem.Icon>
            <mat:MaterialIcon
                Width="{StaticResource MenuIconSize}"
                Height="{StaticResource MenuIconSize}"
                IsVisible="{Binding HasIcon}"
                Kind="{Binding Icon}" />
        </MenuItem.Icon>

        <MenuItem.DataTemplates>
            <DataTemplate x:DataType="vm:MenuViewModel">
                <v:MenuView />
            </DataTemplate>
            <DataTemplate x:DataType="vm:SeparatorViewModel">
                <Separator />
            </DataTemplate>
        </MenuItem.DataTemplates>
    </MenuItem>
</UserControl>