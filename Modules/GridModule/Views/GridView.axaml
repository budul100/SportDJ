<UserControl
    x:Class="SportDJ.Modules.GridModule.Views.GridView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dt="using:SportDJ.Modules.GridModule.DesignTime"
    xmlns:gd="using:AvaloniaGridDefinitionBehavoir"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:v="using:SportDJ.Modules.GridModule.Views"
    xmlns:vm="using:SportDJ.Modules.GridModule.ViewModels"
    d:DesignHeight="300"
    d:DesignWidth="300"
    prism:ViewModelLocator.AutoWireViewModel="False"
    x:CompileBindings="True"
    x:DataType="vm:GridViewModel"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Commons/Assets/Ressources.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Design.DataContext>
        <dt:GridViewModel />
    </Design.DataContext>

    <ItemsControl x:DataType="vm:GridViewModel" ItemsSource="{Binding Cells}">

        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate x:DataType="vm:GridViewModel">

                <Grid
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    gd:GridDefinitionBehavior.ColumnCount="{Binding Columns}"
                    gd:GridDefinitionBehavior.RowCount="{Binding Rows}"
                    gd:GridDefinitionBehavior.StarColumns=".*"
                    gd:GridDefinitionBehavior.StarRows=".*" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>

        <ItemsControl.Styles>
            <Style x:DataType="vm:CellViewModel" Selector="ItemsControl > ContentPresenter">
                <Setter Property="Grid.Row" Value="{Binding Row}" />
                <Setter Property="Grid.Column" Value="{Binding Column}" />
                <Setter Property="Grid.RowSpan" Value="{Binding RowSpan}" />
                <Setter Property="Grid.ColumnSpan" Value="{Binding ColumnSpan}" />
            </Style>
        </ItemsControl.Styles>

        <ItemsControl.DataTemplates>
            <DataTemplate x:DataType="vm:GroupViewModel">
                <v:GroupView />
            </DataTemplate>
            <DataTemplate x:DataType="vm:PlayerViewModel">
                <v:PlayerView />
            </DataTemplate>
            <DataTemplate x:DataType="dt:GroupViewModel">
                <v:GroupView />
            </DataTemplate>
            <DataTemplate x:DataType="dt:PlayerViewModel">
                <v:PlayerView />
            </DataTemplate>
        </ItemsControl.DataTemplates>
    </ItemsControl>
</UserControl>