<UserControl
    x:Class="SportDJ.Modules.GridModule.Views.CanvasView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:gd="using:AvaloniaGridDefinitionBehavoir"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:v="using:SportDJ.Modules.GridModule.Views"
    xmlns:vm="using:SportDJ.Modules.GridModule.ViewModels"
    d:DesignHeight="300"
    d:DesignWidth="500"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">

    <ItemsControl x:DataType="vm:GridViewModel" ItemsSource="{Binding Grids}">

        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate x:DataType="vm:CanvasViewModel">

                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>

        <ItemsControl.DataTemplates>

            <DataTemplate x:DataType="vm:GridViewModel">

                <Grid Background="Black">
                    <v:GridView HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                </Grid>
            </DataTemplate>
        </ItemsControl.DataTemplates>
    </ItemsControl>
</UserControl>