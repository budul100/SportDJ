<Project>

	<Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

	<PropertyGroup>
		<RootNamespace>SportDJ.Modules.$(MSBuildProjectName)</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia" Version="12.1.6" />
		<PackageReference Include="Material.Icons.Avalonia" Version="3.0.2" />
		<PackageReference Include="Xaml.Behaviors.Interactions" Version="12.1.5" />
		<PackageReference Include="Xaml.Behaviors.Interactivity" Version="12.1.5" />
		<ProjectReference Include="$(MSBuildThisFileDirectory)../Commons/Commons.csproj" />
	</ItemGroup>

</Project>
