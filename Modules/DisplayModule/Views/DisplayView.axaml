<UserControl
    x:Class="SportDJ.Modules.DisplayModule.Views.DisplayView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:a="clr-namespace:Avalonia.Xaml.Interactions.Core;assembly=Avalonia.Xaml.Interactions"
    xmlns:ct="using:SportDJ.Commons.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dt="using:SportDJ.Modules.DisplayModule.DesignTime"
    xmlns:i="clr-namespace:Avalonia.Xaml.Interactivity;assembly=Avalonia.Xaml.Interactivity"
    xmlns:mat="using:Material.Icons.Avalonia"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    d:DesignHeight="50"
    d:DesignWidth="300"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">

    <UserControl.Resources>

        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Commons/Assets/Ressources.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>

        <Thickness x:Key="InnerMargin">2,0,2,0</Thickness>

        <x:Double x:Key="IconWidth">30</x:Double>
        <x:Double x:Key="IconHeight">30</x:Double>
    </UserControl.Resources>

    <UserControl.Styles>
        <mat:MaterialIconStyles />
    </UserControl.Styles>

    <Design.DataContext>
        <dt:DisplayViewModel />
    </Design.DataContext>

    <DockPanel LastChildFill="True">

        <ToggleButton
            Margin="{StaticResource ContentMargin}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            DockPanel.Dock="Right"
            Focusable="False"
            IsChecked="{Binding ShowFullscreen}">
            <mat:MaterialIcon
                Grid.Column="0"
                Width="{StaticResource IconWidth}"
                Height="{StaticResource IconHeight}"
                Kind="Fullscreen" />
        </ToggleButton>

        <ToggleButton
            Margin="{StaticResource ContentMargin}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            DockPanel.Dock="Right"
            Focusable="False"
            IsChecked="{Binding ShowSettings}">
            <mat:MaterialIcon
                Width="{StaticResource IconWidth}"
                Height="{StaticResource IconHeight}"
                Kind="Cog" />
        </ToggleButton>

        <Grid Margin="{StaticResource ContentMargin}">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="5*" />
                <ColumnDefinition Width="5*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Margin="{StaticResource InnerMargin}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                BorderBrush="{StaticResource ColorBackground}"
                BorderThickness="{StaticResource DisplayBorderThickness}"
                CornerRadius="{StaticResource DisplayCornerRadius}">

                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="{StaticResource FontSizeDisplay}"
                    FontWeight="Bold"
                    Text="{Binding Clock}" />
            </Border>

            <Border
                Grid.Column="1"
                Margin="{StaticResource InnerMargin}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                BorderThickness="{StaticResource DisplayBorderThickness}"
                Classes.IsEnding="{Binding IsEnding}"
                Classes.IsPlaying="{Binding IsPlaying}"
                CornerRadius="{StaticResource DisplayCornerRadius}">

                <Border.Styles>
                    <Style Selector="Border.IsPlaying">
                        <Setter Property="BorderBrush" Value="{StaticResource ColorIsPlaying}" />
                    </Style>
                    <Style Selector="Border.IsEnding">
                        <Setter Property="BorderBrush" Value="{StaticResource ColorIsEnding}" />
                    </Style>
                    <Style Selector="Border">
                        <Setter Property="BorderBrush" Value="{StaticResource ColorBackground}" />
                    </Style>
                </Border.Styles>

                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

                    <Panel
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Classes.IsEnding="{Binding IsEnding}"
                        Classes.IsPlaying="{Binding IsPlaying}">

                        <Panel.Styles>
                            <Style Selector="Panel.IsPlaying">
                                <Setter Property="Background" Value="{StaticResource ColorIsPlaying}" />
                                <Setter Property="Opacity" Value="{StaticResource DisplayOpacityPlaying}" />
                            </Style>
                            <Style Selector="Panel.IsEnding">
                                <Setter Property="Background" Value="{StaticResource ColorIsEnding}" />
                                <Style.Animations>
                                    <Animation IterationCount="INFINITE" Duration="{StaticResource DisplayDurationEnding}">
                                        <KeyFrame Cue="0%">
                                            <Setter Property="Opacity" Value="{StaticResource DisplayOpacityEndingFrom}" />
                                        </KeyFrame>
                                        <KeyFrame Cue="50%">
                                            <Setter Property="Opacity" Value="{StaticResource DisplayOpacityEndingTo}" />
                                        </KeyFrame>
                                        <KeyFrame Cue="100%">
                                            <Setter Property="Opacity" Value="{StaticResource DisplayOpacityEndingFrom}" />
                                        </KeyFrame>
                                    </Animation>
                                </Style.Animations>
                            </Style>
                        </Panel.Styles>
                    </Panel>

                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="{StaticResource FontSizeDisplay}"
                        Text="{Binding Content}" />
                </Grid>
            </Border>

            <Border
                Grid.Column="2"
                Margin="{StaticResource InnerMargin}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                BorderThickness="{StaticResource DisplayBorderThickness}"
                Classes.IsEnding="{Binding IsEnding}"
                Classes.IsPlaying="{Binding IsPlaying}"
                CornerRadius="{StaticResource DisplayCornerRadius}">

                <Border.Styles>
                    <Style Selector="Border.IsPlaying">
                        <Setter Property="BorderBrush" Value="{StaticResource ColorIsPlaying}" />
                    </Style>
                    <Style Selector="Border.IsEnding">
                        <Setter Property="BorderBrush" Value="{StaticResource ColorIsEnding}" />
                    </Style>
                    <Style Selector="Border">
                        <Setter Property="BorderBrush" Value="{StaticResource ColorBackground}" />
                    </Style>
                </Border.Styles>

                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

                    <Panel
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Classes.IsEnding="{Binding IsEnding}"
                        Classes.IsPlaying="{Binding IsPlaying}">

                        <Panel.Styles>
                            <Style Selector="Panel.IsPlaying">
                                <Setter Property="Background" Value="{StaticResource ColorIsPlaying}" />
                                <Setter Property="Opacity" Value="{StaticResource DisplayOpacityPlaying}" />
                            </Style>
                            <Style Selector="Panel.IsEnding">
                                <Setter Property="Background" Value="{StaticResource ColorIsEnding}" />
                                <Style.Animations>
                                    <Animation IterationCount="INFINITE" Duration="{StaticResource DisplayDurationEnding}">
                                        <KeyFrame Cue="0%">
                                            <Setter Property="Opacity" Value="{StaticResource DisplayOpacityEndingFrom}" />
                                        </KeyFrame>
                                        <KeyFrame Cue="50%">
                                            <Setter Property="Opacity" Value="{StaticResource DisplayOpacityEndingTo}" />
                                        </KeyFrame>
                                        <KeyFrame Cue="100%">
                                            <Setter Property="Opacity" Value="{StaticResource DisplayOpacityEndingFrom}" />
                                        </KeyFrame>
                                    </Animation>
                                </Style.Animations>
                            </Style>
                        </Panel.Styles>
                    </Panel>

                    <ct:TrackRenderer
                        Grid.Row="2"
                        Bitmap="{Binding Bitmap}"
                        Progress="{Binding Progress}" />
                </Grid>
            </Border>

            <Border
                Grid.Column="3"
                Margin="{StaticResource InnerMargin}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                BorderThickness="{StaticResource DisplayBorderThickness}"
                Classes.IsEnding="{Binding IsEnding}"
                Classes.IsPlaying="{Binding IsPlaying}"
                CornerRadius="{StaticResource DisplayCornerRadius}">

                <Border.Styles>
                    <Style Selector="Border.IsPlaying">
                        <Setter Property="BorderBrush" Value="{StaticResource ColorIsPlaying}" />
                    </Style>
                    <Style Selector="Border.IsEnding">
                        <Setter Property="BorderBrush" Value="{StaticResource ColorIsEnding}" />
                    </Style>
                    <Style Selector="Border">
                        <Setter Property="BorderBrush" Value="{StaticResource ColorBackground}" />
                    </Style>
                </Border.Styles>

                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

                    <Panel
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Classes.IsEnding="{Binding IsEnding}"
                        Classes.IsPlaying="{Binding IsPlaying}">

                        <Panel.Styles>
                            <Style Selector="Panel.IsPlaying">
                                <Setter Property="Background" Value="{StaticResource ColorIsPlaying}" />
                                <Setter Property="Opacity" Value="{StaticResource DisplayOpacityPlaying}" />
                            </Style>
                            <Style Selector="Panel.IsEnding">
                                <Setter Property="Background" Value="{StaticResource ColorIsEnding}" />
                                <Style.Animations>
                                    <Animation IterationCount="INFINITE" Duration="{StaticResource DisplayDurationEnding}">
                                        <KeyFrame Cue="0%">
                                            <Setter Property="Opacity" Value="{StaticResource DisplayOpacityEndingFrom}" />
                                        </KeyFrame>
                                        <KeyFrame Cue="50%">
                                            <Setter Property="Opacity" Value="{StaticResource DisplayOpacityEndingTo}" />
                                        </KeyFrame>
                                        <KeyFrame Cue="100%">
                                            <Setter Property="Opacity" Value="{StaticResource DisplayOpacityEndingFrom}" />
                                        </KeyFrame>
                                    </Animation>
                                </Style.Animations>
                            </Style>
                        </Panel.Styles>
                    </Panel>

                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="{StaticResource FontSizeDisplay}"
                        Text="{Binding Remaining}" />
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>