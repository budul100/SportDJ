<UserControl
    x:Class="SportDJ.Modules.DisplayModule.Views.DisplayView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:a="clr-namespace:Avalonia.Xaml.Interactions.Core;assembly=Avalonia.Xaml.Interactions"
    xmlns:ct="using:SportDJ.Shareds.UserControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dt="using:SportDJ.Modules.DisplayModule.DesignTime"
    xmlns:i="clr-namespace:Avalonia.Xaml.Interactivity;assembly=Avalonia.Xaml.Interactivity"
    xmlns:mat="using:Material.Icons.Avalonia"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    d:DesignHeight="50"
    d:DesignWidth="600"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Commons/Assets/Ressources.axaml" />
            </ResourceDictionary.MergedDictionaries>
            
            <Thickness x:Key="InnerMargin">2,0,2,0</Thickness>
        </ResourceDictionary>
    </UserControl.Resources>
    
    <UserControl.Styles>
        <mat:MaterialIconStyles />
    </UserControl.Styles>

    <Design.DataContext>
        <dt:DisplayViewModel />
    </Design.DataContext>

    <DockPanel LastChildFill="True">

        <ToggleButton
            Margin="{StaticResource ContentMargin}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            DockPanel.Dock="Right"
            Focusable="False"
            IsChecked="{Binding ShowFullscreen}">
            <mat:MaterialIcon
                Width="{StaticResource DisplayIconSize}"
                Height="{StaticResource DisplayIconSize}"
                Kind="Fullscreen" />
        </ToggleButton>

        <ToggleButton
            Margin="{StaticResource ContentMargin}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            DockPanel.Dock="Right"
            Focusable="False"
            IsChecked="{Binding ShowSettings}">
            <mat:MaterialIcon
                Width="{StaticResource DisplayIconSize}"
                Height="{StaticResource DisplayIconSize}"
                Kind="Cog" />
        </ToggleButton>

        <Grid Margin="{StaticResource ContentMargin}">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="5*" />
                <ColumnDefinition Width="5*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Margin="{StaticResource InnerMargin}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                BorderBrush="{StaticResource ColorBackground}"
                BorderThickness="{StaticResource DisplayBorderThickness}"
                CornerRadius="{StaticResource DisplayCornerRadius}">

                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="{StaticResource FontSizeContentSub}"
                    FontWeight="Bold"
                    Text="{Binding Clock}" />
            </Border>

            <Border
                Grid.Column="1"
                Margin="{StaticResource InnerMargin}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                BorderThickness="{StaticResource DisplayBorderThickness}"
                Classes.IsEnding="{Binding IsEnding}"
                Classes.IsPlaying="{Binding IsPlaying}"
                CornerRadius="{StaticResource DisplayCornerRadius}">

                <Border.Styles>
                    <Style Selector="Border.IsPlaying">
                        <Setter Property="BorderBrush" Value="{StaticResource ColorIsPlaying}" />
                    </Style>
                    <Style Selector="Border.IsEnding">
                        <Setter Property="BorderBrush" Value="{StaticResource ColorIsEnding}" />
                    </Style>
                    <Style Selector="Border">
                        <Setter Property="BorderBrush" Value="{StaticResource ColorBackground}" />
                    </Style>
                </Border.Styles>

                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

                    <Panel
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Background="{StaticResource ColorIsPlaying}"
                        IsVisible="{Binding IsPlaying}"
                        Opacity="{StaticResource DisplayOpacityPlaying}" />

                    <ct:FlashingPanel
                        DurationMilliSecs="{StaticResource DisplayFlashingDurationMilliSecs}"
                        IsActive="{Binding IsEnding}"
                        OpacityMax="{StaticResource DisplayOpacityEndingMax}"
                        OpacityMin="{StaticResource DisplayOpacityEndingMin}"
                        Color="{StaticResource ColorIsEnding}" />

                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="{StaticResource FontSizeContentSub}"
                        Text="{Binding Content}" />
                </Grid>
            </Border>

            <Border
                Grid.Column="2"
                Margin="{StaticResource InnerMargin}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                BorderThickness="{StaticResource DisplayBorderThickness}"
                Classes.IsEnding="{Binding IsEnding}"
                Classes.IsPlaying="{Binding IsPlaying}"
                CornerRadius="{StaticResource DisplayCornerRadius}">

                <Border.Styles>
                    <Style Selector="Border.IsPlaying">
                        <Setter Property="BorderBrush" Value="{StaticResource ColorIsPlaying}" />
                    </Style>
                    <Style Selector="Border.IsEnding">
                        <Setter Property="BorderBrush" Value="{StaticResource ColorIsEnding}" />
                    </Style>
                    <Style Selector="Border">
                        <Setter Property="BorderBrush" Value="{StaticResource ColorBackground}" />
                    </Style>
                </Border.Styles>

                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

                    <Panel
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Background="{StaticResource ColorIsPlaying}"
                        IsVisible="{Binding IsPlaying}"
                        Opacity="{StaticResource DisplayOpacityPlaying}" />

                    <ct:FlashingPanel
                        DurationMilliSecs="{StaticResource DisplayFlashingDurationMilliSecs}"
                        IsActive="{Binding IsEnding}"
                        OpacityMax="{StaticResource DisplayOpacityEndingMax}"
                        OpacityMin="{StaticResource DisplayOpacityEndingMin}"
                        Color="{StaticResource ColorIsEnding}" />

                    <ct:WaveRenderer
                        Bitmap="{Binding Bitmap}"
                        OpacityPlayed="{StaticResource TrackOpacityPlayed}"
                        Progress="{Binding Progress}" />
                </Grid>
            </Border>

            <Border
                Grid.Column="3"
                Margin="{StaticResource InnerMargin}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                BorderThickness="{StaticResource DisplayBorderThickness}"
                Classes.IsEnding="{Binding IsEnding}"
                Classes.IsPlaying="{Binding IsPlaying}"
                CornerRadius="{StaticResource DisplayCornerRadius}">

                <Border.Styles>
                    <Style Selector="Border.IsPlaying">
                        <Setter Property="BorderBrush" Value="{StaticResource ColorIsPlaying}" />
                    </Style>
                    <Style Selector="Border.IsEnding">
                        <Setter Property="BorderBrush" Value="{StaticResource ColorIsEnding}" />
                    </Style>
                    <Style Selector="Border">
                        <Setter Property="BorderBrush" Value="{StaticResource ColorBackground}" />
                    </Style>
                </Border.Styles>

                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

                    <Panel
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Background="{StaticResource ColorIsPlaying}"
                        IsVisible="{Binding IsPlaying}"
                        Opacity="{StaticResource DisplayOpacityPlaying}" />

                    <ct:FlashingPanel
                        DurationMilliSecs="{StaticResource DisplayFlashingDurationMilliSecs}"
                        IsActive="{Binding IsEnding}"
                        OpacityMax="{StaticResource DisplayOpacityEndingMax}"
                        OpacityMin="{StaticResource DisplayOpacityEndingMin}"
                        Color="{StaticResource ColorIsEnding}" />

                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="{StaticResource FontSizeContentSub}"
                        Text="{Binding Remaining}" />
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>