<UserControl
    x:Class="SportDJ.Modules.DisplayModule.Views.DisplayView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:a="clr-namespace:Avalonia.Xaml.Interactions.Core;assembly=Avalonia.Xaml.Interactions"
    xmlns:co="using:SportDJ.Commons.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dt="using:SportDJ.Modules.DisplayModule.DesignTime"
    xmlns:i="clr-namespace:Avalonia.Xaml.Interactivity;assembly=Avalonia.Xaml.Interactivity"
    xmlns:mat="using:Material.Icons.Avalonia"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    d:DesignHeight="50"
    d:DesignWidth="300"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">

    <UserControl.Resources>

        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Commons/Assets/Ressources.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>

        <Thickness x:Key="InnerMargin">2</Thickness>
        <CornerRadius x:Key="CornerRadius">3</CornerRadius>

        <x:Double x:Key="IconWidth">30</x:Double>
        <x:Double x:Key="IconHeight">30</x:Double>

        <co:BoolToGridSizeAutoConverter x:Key="BoolToGridSizeAutoConverter" />
        <co:BoolToGridSizeStarConverter x:Key="BoolToGridSizeStarConverter" />
        <co:LongToGridStarConverter x:Key="LongToGridStarConverter" />
    </UserControl.Resources>

    <UserControl.Styles>
        <mat:MaterialIconStyles />
    </UserControl.Styles>

    <Design.DataContext>
        <dt:DisplayViewModel />
    </Design.DataContext>

    <DockPanel LastChildFill="True">

        <ToggleButton
            Margin="{StaticResource ContentMargin}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            DockPanel.Dock="Right"
            IsChecked="{Binding ShowFullscreen}">
            <mat:MaterialIcon
                Grid.Column="0"
                Width="{StaticResource IconWidth}"
                Height="{StaticResource IconHeight}"
                Kind="Fullscreen" />
        </ToggleButton>

        <ToggleButton
            Margin="{StaticResource ContentMargin}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            DockPanel.Dock="Right"
            IsChecked="{Binding ShowSettings}">
            <mat:MaterialIcon
                Width="{StaticResource IconWidth}"
                Height="{StaticResource IconHeight}"
                Kind="Cog" />
        </ToggleButton>

        <Grid Margin="{StaticResource ContentMargin}">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="5*" />
                <ColumnDefinition Width="5*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Margin="{StaticResource InnerMargin}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="{StaticResource ColorBackground}"
                CornerRadius="{StaticResource CornerRadius}">

                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="{StaticResource FontSizeDisplay}"
                    FontWeight="Bold"
                    Text="{Binding Clock}" />
            </Border>

            <Border
                Grid.Column="1"
                Margin="{StaticResource InnerMargin}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="{StaticResource ColorBackground}"
                CornerRadius="{StaticResource CornerRadius}">

                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="{StaticResource FontSizeDisplay}"
                    Text="{Binding Content}" />
            </Border>

            <Border
                Grid.Column="2"
                Margin="{StaticResource InnerMargin}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="{StaticResource ColorBackground}"
                CornerRadius="{StaticResource CornerRadius}">

                <i:Interaction.Behaviors>
                    <a:DataTriggerBehavior
                        Binding="{Binding IsEnding}"
                        ComparisonCondition="Equal"
                        Value="True">
                        <a:ChangePropertyAction PropertyName="Background" Value="{StaticResource ColorIsEnding}" />
                    </a:DataTriggerBehavior>
                    <a:DataTriggerBehavior
                        Binding="{Binding IsEnding}"
                        ComparisonCondition="NotEqual"
                        Value="True">
                        <a:ChangePropertyAction PropertyName="Background" Value="{StaticResource ColorBackground}" />
                    </a:DataTriggerBehavior>
                </i:Interaction.Behaviors>

                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{Binding WidthPosition, Converter={StaticResource LongToGridStarConverter}}" />
                        <ColumnDefinition Width="{Binding WidthRemaining, Converter={StaticResource LongToGridStarConverter}}" />
                    </Grid.ColumnDefinitions>

                    <Image
                        Grid.Row="0"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Source="{Binding Bitmap}"
                        Stretch="Fill" />

                    <Border
                        Grid.Row="0"
                        Grid.Column="0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Background="{StaticResource ColorBackground}"
                        CornerRadius="{StaticResource CornerRadius}">

                        <i:Interaction.Behaviors>
                            <a:DataTriggerBehavior
                                Binding="{Binding IsEnding}"
                                ComparisonCondition="Equal"
                                Value="True">
                                <a:ChangePropertyAction PropertyName="Background" Value="{StaticResource ColorIsEnding}" />
                            </a:DataTriggerBehavior>
                            <a:DataTriggerBehavior
                                Binding="{Binding IsEnding}"
                                ComparisonCondition="NotEqual"
                                Value="True">
                                <a:ChangePropertyAction PropertyName="Background" Value="{StaticResource ColorBackground}" />
                            </a:DataTriggerBehavior>
                        </i:Interaction.Behaviors>
                    </Border>
                </Grid>
            </Border>

            <Border
                Grid.Column="3"
                Margin="{StaticResource InnerMargin}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="{StaticResource ColorBackground}"
                CornerRadius="{StaticResource CornerRadius}">

                <i:Interaction.Behaviors>
                    <a:DataTriggerBehavior
                        Binding="{Binding IsEnding}"
                        ComparisonCondition="Equal"
                        Value="True">
                        <a:ChangePropertyAction PropertyName="Background" Value="{StaticResource ColorIsEnding}" />
                    </a:DataTriggerBehavior>
                    <a:DataTriggerBehavior
                        Binding="{Binding IsEnding}"
                        ComparisonCondition="NotEqual"
                        Value="True">
                        <a:ChangePropertyAction PropertyName="Background" Value="{StaticResource ColorBackground}" />
                    </a:DataTriggerBehavior>
                </i:Interaction.Behaviors>

                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="{StaticResource FontSizeDisplay}"
                    Text="{Binding Remaining}" />
            </Border>
        </Grid>
    </DockPanel>
</UserControl>