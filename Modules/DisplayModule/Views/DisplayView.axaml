<UserControl
    x:Class="SportDJ.Modules.DisplayModule.Views.DisplayView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dt="using:SportDJ.Modules.DisplayModule.DesignTime"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    d:DesignHeight="50"
    d:DesignWidth="300"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">

    <UserControl.Resources>

        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Commons/Assets/Ressources.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>

        <Thickness x:Key="InnerMargin">2</Thickness>

        <CornerRadius x:Key="CornerRadius">3</CornerRadius>

        <Color x:Key="Background">#333333</Color>

    </UserControl.Resources>

    <Design.DataContext>
        <dt:DisplayViewModel />
    </Design.DataContext>

    <Grid Margin="{StaticResource ContentMargin}">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="4*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <Border
            Grid.Row="0"
            Grid.Column="0"
            Margin="{StaticResource InnerMargin}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="{StaticResource Background}"
            CornerRadius="{StaticResource CornerRadius}">

            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="{StaticResource ContentFontSize}"
                Text="{Binding Clock}" />
        </Border>

        <Border
            Grid.Row="0"
            Grid.Column="1"
            Margin="{StaticResource InnerMargin}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="{StaticResource Background}"
            CornerRadius="{StaticResource CornerRadius}">

            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="{StaticResource ContentFontSize}">
                Box 1
            </TextBlock>
        </Border>

        <Border
            Grid.Row="0"
            Grid.Column="2"
            Margin="{StaticResource InnerMargin}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="{StaticResource Background}"
            CornerRadius="{StaticResource CornerRadius}">

            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="{StaticResource ContentFontSize}">
                Box 1
            </TextBlock>
        </Border>
    </Grid>
</UserControl>