<UserControl
    x:Class="SportDJ.Modules.DisplayModule.Views.DisplayView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:a="clr-namespace:Avalonia.Xaml.Interactions.Core;assembly=Avalonia.Xaml.Interactions"
    xmlns:ct="using:SportDJ.Shareds.UserControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dt="using:SportDJ.Modules.DisplayModule.DesignTime"
    xmlns:i="clr-namespace:Avalonia.Xaml.Interactivity;assembly=Avalonia.Xaml.Interactivity"
    xmlns:mat="using:Material.Icons.Avalonia"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:SportDJ.Modules.DisplayModule.ViewModels"
    xmlns:vml="using:SportDJ.Shareds.ViewModelLocator"
    d:DesignHeight="50"
    d:DesignWidth="600"
    vml:ViewModelLocator.AutoWireViewModel="True"
    x:DataType="vm:DisplayViewModel"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Commons/Assets/Ressources.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.Styles>
        <mat:MaterialIconStyles />
    </UserControl.Styles>

    <Design.DataContext>
        <dt:DisplayViewModel />
    </Design.DataContext>

    <DockPanel LastChildFill="True">

        <ToggleButton
            Margin="{StaticResource ContentMargin}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            DockPanel.Dock="Right"
            Focusable="False"
            IsChecked="{Binding ShowFullscreen}">
            <mat:MaterialIcon
                Width="{StaticResource DisplayIconSize}"
                Height="{StaticResource DisplayIconSize}"
                Kind="Fullscreen" />
        </ToggleButton>

        <ToggleButton
            Margin="{StaticResource ContentMargin}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            DockPanel.Dock="Right"
            IsChecked="{Binding IsSettingsVisible, Mode=OneWay}"
            Command="{Binding ShowSettingsCommand}"
            Focusable="False">
            <mat:MaterialIcon
                Width="{StaticResource DisplayIconSize}"
                Height="{StaticResource DisplayIconSize}"
                Kind="Cog" />
        </ToggleButton>

        <Grid Margin="{StaticResource ContentMargin}">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="6*" />
                <ColumnDefinition Width="4*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <!-- Clock -->
            <Border
                Grid.Column="0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Classes="DisplayField">

                <!-- The viewbox only shrinks the text if the field is too small for it -->
                <Viewbox
                    Margin="{StaticResource InnerMargin}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Stretch="Uniform"
                    StretchDirection="DownOnly">
                    <TextBlock
                        FontSize="{StaticResource FontSizeDisplay}"
                        FontWeight="{StaticResource FontWeightTitle}"
                        Text="{Binding Clock}" />
                </Viewbox>
            </Border>

            <!-- Track info -->
            <Border
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Classes="DisplayField"
                Classes.IsPlaying="{Binding IsPlaying}"
                Classes.IsEnding="{Binding IsEnding}">

                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

                    <Panel
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Background="{StaticResource ColorIsPlaying}"
                        IsVisible="{Binding IsPlaying}"
                        Opacity="{StaticResource DisplayOpacityPlaying}" />

                    <ct:FlashingPanel
                        DurationMilliSecs="{StaticResource DisplayFlashingDurationMilliSecs}"
                        IsActive="{Binding IsEnding}"
                        OpacityMax="{StaticResource DisplayOpacityEndingMax}"
                        OpacityMin="{StaticResource DisplayOpacityEndingMin}"
                        Color="{StaticResource ColorIsEnding}" />

                    <Viewbox
                        Margin="{StaticResource InnerMargin}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Stretch="Uniform"
                        StretchDirection="DownOnly">
                        <TextBlock
                            FontSize="{StaticResource FontSizeDisplay}"
                            Text="{Binding Content}" />
                    </Viewbox>
                </Grid>
            </Border>

            <!-- Waveform -->
            <Border
                Grid.Column="2"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Classes="DisplayField"
                Classes.IsPlaying="{Binding IsPlaying}"
                Classes.IsEnding="{Binding IsEnding}">

                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

                    <Panel
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Background="{StaticResource ColorIsPlaying}"
                        IsVisible="{Binding IsPlaying}"
                        Opacity="{StaticResource DisplayOpacityPlaying}" />

                    <ct:FlashingPanel
                        DurationMilliSecs="{StaticResource DisplayFlashingDurationMilliSecs}"
                        IsActive="{Binding IsEnding}"
                        OpacityMax="{StaticResource DisplayOpacityEndingMax}"
                        OpacityMin="{StaticResource DisplayOpacityEndingMin}"
                        Color="{StaticResource ColorIsEnding}" />

                    <ct:WaveRenderer
                        Margin="{StaticResource InnerMargin}"
                        VerticalAlignment="Stretch"
                        HorizontalAlignment="Stretch"
                        Bitmap="{Binding Bitmap}"
                        OpacityPlayed="{StaticResource TrackOpacityPlayed}"
                        Progress="{Binding Progress, TargetNullValue=0}" />
                </Grid>
            </Border>

            <!-- Remaining time -->
            <Border
                Grid.Column="3"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Classes="DisplayField"
                Classes.IsPlaying="{Binding IsPlaying}"
                Classes.IsEnding="{Binding IsEnding}">

                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

                    <Panel
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Background="{StaticResource ColorIsPlaying}"
                        IsVisible="{Binding IsPlaying}"
                        Opacity="{StaticResource DisplayOpacityPlaying}" />

                    <ct:FlashingPanel
                        DurationMilliSecs="{StaticResource DisplayFlashingDurationMilliSecs}"
                        IsActive="{Binding IsEnding}"
                        OpacityMax="{StaticResource DisplayOpacityEndingMax}"
                        OpacityMin="{StaticResource DisplayOpacityEndingMin}"
                        Color="{StaticResource ColorIsEnding}" />

                    <Viewbox
                        Margin="{StaticResource InnerMargin}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Stretch="Uniform"
                        StretchDirection="DownOnly">
                        <TextBlock
                            FontSize="{StaticResource FontSizeDisplay}"
                            FontWeight="{StaticResource FontWeightTitle}"
                            Text="{Binding Remaining}" />
                    </Viewbox>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>