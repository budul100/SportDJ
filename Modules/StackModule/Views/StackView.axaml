<UserControl
    x:Class="SportDJ.Modules.StackModule.Views.StackView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ct="using:SportDJ.Shareds.UserControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dt="using:SportDJ.Modules.StackModule.DesignTime"
    xmlns:i="using:Avalonia.Xaml.Interactivity"
    xmlns:ia="using:Avalonia.Xaml.Interactions.Core"
    xmlns:mat="using:Material.Icons.Avalonia"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:vml="using:SportDJ.Shareds.ViewModelLocator"
    x:Name="StackViewControl"
    d:DesignHeight="500"
    d:DesignWidth="300"
    mc:Ignorable="d"
    vml:ViewModelLocator.AutoWireViewModel="True">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Commons/Assets/Ressources.axaml" />
            </ResourceDictionary.MergedDictionaries>

            <Thickness x:Key="InnerMargin">2</Thickness>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.Styles>
        <mat:MaterialIconStyles />
        
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="{StaticResource InnerMargin}" />
        </Style>

        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </UserControl.Styles>

    <Design.DataContext>
        <dt:StackViewModel />
    </Design.DataContext>

    <DockPanel Margin="{StaticResource ContentMargin}" LastChildFill="True">

        <Grid
			Margin="{StaticResource ContentMargin}"
			ColumnDefinitions="*,*"
			DockPanel.Dock="Top">
			<Button
				Grid.Column="0"
				Margin="{StaticResource InnerMargin}"
				HorizontalAlignment="Stretch"
				VerticalAlignment="Stretch"
				Command="{Binding ResetCommand}"
				Focusable="False">
				<mat:MaterialIcon
					Width="{StaticResource MediumIconSize}"
					Height="{StaticResource MediumIconSize}"
					Kind="History" />
			</Button>
			<Button
				Grid.Column="1"
				Margin="{StaticResource InnerMargin}"
				HorizontalAlignment="Stretch"
				VerticalAlignment="Stretch"
				Command="{Binding ShuffleCommand}"
				Focusable="False">
				<mat:MaterialIcon
					Width="{StaticResource MediumIconSize}"
					Height="{StaticResource MediumIconSize}"
					Kind="ShuffleVariant" />
			</Button>
		</Grid>

        <ListBox 
            ItemsSource="{Binding Entries}" 
            SelectedItem="{Binding Active, Mode=TwoWay}"
            Margin="{StaticResource ContentMargin}">

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <ct:EntryView 
                        Entry="{Binding}"
                        EventAggregator="{Binding #StackViewControl.DataContext.EventAggregator}">
                        <i:Interaction.Behaviors>
                            <ia:EventTriggerBehavior EventName="DoubleTapped">
                                <ia:InvokeCommandAction 
                                    Command="{Binding #StackViewControl.DataContext.SelectCommand}"
                                    CommandParameter="{Binding}" />
                            </ia:EventTriggerBehavior>
                        </i:Interaction.Behaviors>
                    </ct:EntryView>

                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

    </DockPanel>
</UserControl>